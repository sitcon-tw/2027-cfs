---
import Page from "../index.astro";
import { loadItemsData } from "../../utils/items-loader";
import { createItemSchema } from "../../utils/item-schema";

export const getStaticPaths = async () => {
	const lang = "zh-Hant";
	const items = await loadItemsData(lang);

	return items.map(item => ({
		params: { id: item.id },
		props: {
			item,
			lang
		}
	}));
};

const { item, lang } = Astro.props;
const t = await import(`../../i18n/${lang}.json`).then(m => m.default);

// Generate SEO-friendly title and description
const title = `${item.name} - ${t.meta.title}`;
const description = item.global_description || t.meta.description;

const productSchema = createItemSchema(item, description, new URL(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/items/`, Astro.site));
---

<Page lang={lang} title={title} description={description}>
	<Fragment slot="schema">
		{productSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} is:inline />}
	</Fragment>
</Page>
