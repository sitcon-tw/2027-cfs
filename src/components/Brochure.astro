---
type NumericData = Record<string, number>;
import { getImage } from "astro:assets";
import photo from "@assets/img/about-popup-2026.webp";
import planData from "@data/plan.json";
import { loadItemsData } from "../utils/items-loader";
import { getBenefitLocalizedName } from "../utils/plan-helper";
const { lang = "zh-Hant" } = Astro.props;
const en = lang === "en";
const t = (await import(`../i18n/${lang}.json`)).default;
const items = await loadItemsData(lang);
const plans = Object.values(planData).sort((a, b) => a.order - b.order);
const extras = items.filter(item => item.type !== "打包專屬").sort((a, b) => a.order - b.order);
const itemsPerPage = en ? 6 : 7;
const groups = Array.from({ length: Math.ceil(extras.length / itemsPerPage) }, (_, i) => extras.slice(i * itemsPerPage, (i + 1) * itemsPerPage));
const hero = await getImage({ src: photo, width: 1000, quality: 65, format: "jpeg" });
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = `${Astro.site?.origin || "https://sitcon.org"}${base}/${en ? "en/" : ""}`;
const plain = (text: string) =>
	text
		.replace(/!\[[^\]]*\]\([^)]*\)/g, "")
		.replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
		.replace(/<[^>]*>/g, "")
		.replace(/[#*`_]/g, "")
		.replace(/\s+/g, " ")
		.trim();
const excerpt = (text: string) => {
	const value = plain(text);
	const max = en ? 175 : 76;
	return value.length > max ? value.slice(0, max) + "…" : value;
};
const pageCount = groups.length + 4;
const audienceTotal = Object.values(t.about.popup.chart.attender_role as NumericData).reduce((sum, value) => sum + value, 0);
const date = new Date().toLocaleDateString(en ? "en-CA" : "zh-TW", { timeZone: "Asia/Taipei" });
const label = (zh: string, english: string) => (en ? english : zh);
---

<!doctype html>
<html lang={lang}>
	<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{label("SITCON 2027 贊助簡介與報價參考", "SITCON 2027 Sponsorship Overview & Pricing")}</title></head>
	<body>
		<div class="toolbar">
			<a href={site}>← {label("返回贊助網站", "Back to website")}</a><span>
				{label("建議選擇 A4、關閉頁首及頁尾，另存為 PDF。", "Choose A4, disable headers and footers, and save as PDF.")}
			</span><button id="print">{label("下載／列印 PDF", "Save / print PDF")}</button>
		</div>
		<main>
			<section class="page cover">
				<header>SITCON 2027 <span>{label("贊助合作", "SPONSORSHIP")}</span></header>
				<p class="eyebrow">STUDENTS × TECHNOLOGY × COMMUNITY</p>
				<h1>{label("讓學生的潛力，\n遇見產業的支持。", "Connect student potential\nwith industry support.")}</h1>
				<p class="lead">{label("贊助簡介與報價參考", "Sponsorship overview & pricing")}</p>
				<img class="hero" src={hero.src} alt={label("SITCON 2026 年會合照", "Group photo at SITCON 2026")} />
				<div class="event"><strong>{t.time.date}</strong><span>{t.time.location}</span></div>
				<p>{t.intro.sentence1} {t.intro.sentence2}</p>
				<p class="note">
					{label("本簡介提供合作方向與價格概覽；詳細規格、名額與合作條件，請與團隊確認。", "An overview of opportunities and pricing. Confirm specifications, availability and terms with our team.")}
				</p>
				<footer><span>{date} · contact@sitcon.org</span><span>1 / {pageCount}</span></footer>
			</section>
			<section class="page">
				<header>SITCON 2027 <span>{label("受眾與合作價值", "AUDIENCE & VALUE")}</span></header>
				<h2>{t.about.review.title}</h2>
				<div class="metrics">
					{
						t.about.review.stats.map((stat: { label: string; number: string; note: string }) => (
							<div>
								<>
									<strong>{stat.number}</strong>
									<span>
										{stat.label} {stat.note}
									</span>
								</>
							</div>
						))
					}
				</div>
				<p class="note">{t.about.review.note}</p>
				<h2>{t.highlights.title}</h2>
				<div class="opportunities">
					{
						t.highlights.cards.map((card: { title: string; description: string }) => (
							<article>
								<>
									<h3>{card.title}</h3>
									<p>{card.description}</p>
								</>
							</article>
						))
					}
				</div>
				<h3>{t.about.popup.chart.attender_role_title}</h3>
				<div class="audience">
					{
						Object.entries(t.about.popup.chart.attender_role as NumericData).map(([name, count]) => (
							<div>
								<>
									<span>{name}</span>
									<strong>{((count / audienceTotal) * 100).toFixed(1)}%</strong>
								</>
							</div>
						))
					}
				</div>
				<p class="note">{t.about.popup.chart.source_note}</p>
				<footer><span>{site}</span><span>2 / {pageCount}</span></footer>
			</section>
			<section class="page">
				<header>SITCON 2027 <span>{label("方案報價", "PLAN PRICING")}</span></header>
				<h2>{label("一次選好，完整合作", "Choose your sponsorship plan")}</h2>
				<p>{label("所有金額以新臺幣（NT$）表示。", "All prices are in New Taiwan Dollars (NT$).")}</p>
				<div class="plan-table-scroll" role="region" aria-label={label("方案報價比較", "Plan pricing comparison")} tabindex="0">
					<table class="plans">
						<thead>
							<tr>
								<th>{label("權益", "Benefit")}</th>{
									plans.map(plan => (
										<th>
											{en ? plan.name_en : plan.name_zh}
											<strong>{plan.price}</strong>
										</th>
									))
								}
							</tr>
						</thead><tbody>
							{
								plans[0].benefits.map((benefit, index) => (
									<tr>
										<th scope="row">{getBenefitLocalizedName(benefit, lang)}</th>
										{plans.map(plan => {
											const value = plan.benefits[index]?.quantity;
											const item = items.find(i => i.id === benefit.item_id);
											const unit = item?.unit ? t.global.unit[item.unit] || item.unit : "";
											return <td>{!value ? "—" : /^[oO]$/.test(value) ? "✓" : `${value}${/^\d+$/.test(value) ? ` ${unit}` : ""}`}</td>;
										})}
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
				<p class="note">{label("✓ 表示包含該權益；— 表示未包含。詳細執行規格與可加購項目請見網站。", "✓ Included; — not included. Visit the website for specifications and available add-ons.")}</p>
				<p class="callout">
					{label("可以先選擇方案，再依人才招募、品牌曝光或產品推廣需求搭配下列品項。", "Select a plan, then explore the following options for recruitment, brand exposure or product promotion.")}
				</p>
				<footer><span>contact@sitcon.org</span><span>3 / {pageCount}</span></footer>
			</section>
			{
				groups.map((group, pageIndex) => (
					<section class="page catalog">
						<header>
							SITCON 2027{" "}
							<span>
								{label("品項報價", "ITEM PRICING")} {pageIndex + 1} / {groups.length}
							</span>
						</header>
						<h2>{label("依合作目標，搭配贊助品項", "Find the right sponsorship options")}</h2>
						<p class="note">
							{label(
								"各品項／子品項報價參考；截止時間與名額請洽團隊確認，完整內容請開啟品項連結。",
								"Reference prices per item or option. Confirm deadlines and availability with our team; follow item links for details."
							)}
						</p>
						<div class="catalog-list">
							{group.map(item => (
								<article>
									<div>
										<h3>
											<a href={`${site}item/${item.id}/`}>{item.name}</a>
										</h3>
										<p>{excerpt(item.global_description)}</p>
									</div>
									<div class="pricing">
										{item.sub.length ? (
											item.sub.map(sub => (
												<p>
													<span>{sub.name}</span>
													<strong>
														{sub.price || label("洽詢", "Contact us")}
														{sub.remaining === "0" && <small>{label("已額滿", "Sold out")}</small>}
													</strong>
												</p>
											))
										) : (
											<strong>{item.price || label("洽詢", "Contact us")}</strong>
										)}
										{item.remaining === "0" && <small>{label("已額滿", "Sold out")}</small>}
									</div>
								</article>
							))}
						</div>
						<footer>
							<>
								<span>{label("幣別：新臺幣 NT$", "Currency: NT$")} · contact@sitcon.org</span>
								<span>
									{pageIndex + 4} / {pageCount}
								</span>
							</>
						</footer>
					</section>
				))
			}
			<section class="page">
				<header>SITCON 2027 <span>{label("教育支持與聯絡", "EDUCATION & CONTACT")}</span></header>
				<h2>{t.opendream.title}</h2><p>{t.opendream.description}</p>
				<div class="dream-plans">
					{
						t.opendream.plans.map((plan: { name: string; price: string }) => (
							<div>
								<>
									<h3>{plan.name}</h3>
									<strong>{plan.price}</strong>
								</>
							</div>
						))
					}
				</div>
				<p><a href={`${site}#opendream`}>{label("查看開源築夢計畫完整權益 →", "Explore Open Dream benefits →")}</a></p>
				<p class="note">{t.opendream.price_note}</p>
				<h2>{label("場地規模", "Venue overview")}</h2>
				<table>
					<tbody>
						{
							t.time.place_items.slice(0, 3).map((venue: { code: string; name: string; description: string }) => (
								<tr>
									<>
										<th scope="row">
											{venue.code}
											<br />
											{venue.name}
										</th>
										<td>{venue.description}</td>
									</>
								</tr>
							))
						}
					</tbody>
				</table>
				<h2>{label("開始討論合作", "Let's talk")}</h2>
				<p>
					{
						label(
							"請告訴我們單位名稱、合作目標、感興趣的方案或品項及聯絡方式。我們會協助確認名額、執行內容與後續合作細節。",
							"Tell us your organization, goals, preferred plan or items, and contact details. We will confirm availability, deliverables and next steps."
						)
					}
				</p>
				<a class="contact" href="mailto:contact@sitcon.org">contact@sitcon.org</a>
				<p><a href={site}>{site}</a></p>
				<p class="note">
					{
						label(
							"本文件為合作簡介與報價參考，非訂單或付款憑證。價格及名額以雙方確認的合作內容為準。",
							"This document is a sponsorship overview and pricing reference, not an order or receipt. Pricing and availability are subject to mutual confirmation."
						)
					}
				</p>
				<footer><span>{date} · SITCON 2027</span><span>{pageCount} / {pageCount}</span></footer>
			</section>
		</main>
		<script>
			document.getElementById("print")?.addEventListener("click", async () => {
				await document.fonts.ready;
				window.print();
			});
		</script>
	</body>
</html>
<style is:global>
	@import url("https://font.emtech.cc/css/LINESeedTW/400");
	@import url("https://font.emtech.cc/css/LINESeedTW/700");
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		color: #203329;
		background: #e8ece8;
		font-family: LINESeedTW, system-ui, sans-serif;
		font-size: 11pt;
		line-height: 1.6;
	}
	.toolbar {
		padding: 1rem;
		display: flex;
		gap: 1rem;
		align-items: center;
		justify-content: center;
		background: white;
		flex-wrap: wrap;
	}
	.toolbar span {
		font-size: 0.9rem;
	}
	button {
		font: inherit;
		border: 0;
		border-radius: 0.5rem;
		padding: 0.6rem 1rem;
		background: #226c44;
		color: white;
		cursor: pointer;
	}
	a {
		color: #226c44;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		overflow-wrap: anywhere;
	}
	.page {
		width: 210mm;
		min-height: 297mm;
		margin: 1.5rem auto;
		padding: 15mm 17mm;
		background: white;
		display: flex;
		flex-direction: column;
	}
	header,
	footer {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 9pt;
	}
	header {
		border-bottom: 2px solid #226c44;
		padding-bottom: 3mm;
		font-weight: bold;
		letter-spacing: 0.06em;
	}
	footer {
		border-top: 1px solid #c7d7c9;
		padding-top: 3mm;
		margin-top: auto;
		color: #526657;
	}
	h1 {
		white-space: pre-line;
		font-size: 29pt;
		line-height: 1.4;
		margin: 4mm 0;
	}
	h2 {
		font-size: 20pt;
		line-height: 1.4;
		margin: 8mm 0 4mm;
	}
	h3 {
		font-size: 12pt;
		line-height: 1.5;
		margin: 0 0 2mm;
	}
	p {
		margin: 2mm 0 4mm;
	}
	.eyebrow {
		font-size: 9pt;
		letter-spacing: 0.15em;
		margin-top: 9mm;
		color: #52745c;
	}
	.lead {
		font-size: 15pt;
	}
	.hero {
		width: 100%;
		height: 75mm;
		object-fit: cover;
		border-radius: 3mm;
		margin: 4mm 0;
	}
	.event {
		display: flex;
		flex-direction: column;
		gap: 1mm;
		margin: 4mm 0;
		font-size: 13pt;
	}
	.note {
		font-size: 9pt;
		color: #526657;
	}
	.metrics {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4mm;
	}
	.metrics > div,
	.dream-plans > div {
		background: #eff5ee;
		padding: 5mm;
		border-radius: 2mm;
	}
	.metrics strong {
		display: block;
		font-size: 26pt;
		color: #226c44;
	}
	.metrics span {
		display: block;
	}
	.opportunities {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 5mm;
		margin-bottom: 5mm;
	}
	.opportunities p {
		font-size: 10pt;
	}
	.audience {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1mm 8mm;
	}
	.audience > div {
		display: flex;
		justify-content: space-between;
		border-bottom: 1px solid #e0e5df;
		padding: 1mm 0;
	}
	table {
		border-collapse: collapse;
		width: 100%;
		margin: 3mm 0;
		font-size: 10pt;
	}
	th,
	td {
		text-align: left;
		padding: 2.5mm;
		border-bottom: 1px solid #ccd8ce;
	}
	th {
		font-weight: 600;
	}
	thead {
		background: #eff5ee;
	}
	.plans th:first-child {
		width: 31%;
	}
	.plans thead th {
		font-size: 10pt;
	}
	.plans thead strong {
		display: block;
		white-space: nowrap;
		margin-top: 2mm;
	}
	.plans td {
		text-align: center;
		font-size: 10pt;
	}
	.callout {
		background: #eff5ee;
		padding: 4mm;
		margin-top: 6mm;
	}
	.catalog h2 {
		font-size: 18pt;
	}
	.catalog-list article {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 5mm;
		padding: 3mm 0;
		border-bottom: 1px solid #ccd8ce;
		break-inside: avoid;
	}
	.catalog-list h3 {
		font-size: 11pt;
		margin: 0 0 1mm;
	}
	.catalog-list p {
		font-size: 9pt;
		margin: 0;
		line-height: 1.5;
	}
	.catalog-list h3 a {
		text-decoration: none;
	}
	.pricing p {
		display: flex;
		justify-content: space-between;
		gap: 2mm;
	}
	.pricing strong {
		white-space: nowrap;
		font-size: 10pt;
	}
	.pricing small {
		display: block;
		font-size: 8pt;
		color: #526657;
		margin-top: 1mm;
	}
	.dream-plans {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4mm;
		margin: 4mm 0;
	}
	.contact {
		font-size: 22pt;
		font-weight: bold;
		margin: 4mm 0;
	}
	@media screen and (max-width: 820px) {
		.page {
			width: 100%;
			min-height: auto;
			padding: 1.5rem;
		}
		h1 {
			font-size: 24pt;
		}
		.hero {
			height: auto;
		}
		.plans {
			font-size: 8pt;
		}
		.plans th,
		.plans td {
			font-size: 8pt;
			padding: 1mm;
		}
		.plans thead th {
			font-size: 8pt;
		}
		footer {
			margin-top: 2rem;
		}
	}
	.plans {
		line-height: 1.35;
		font-size: 9pt;
	}
	.plans th,
	.plans td {
		padding: 1.8mm;
		font-size: 9pt;
	}
	.plans th:first-child {
		width: 36%;
	}
	.plans thead th {
		font-size: 9pt;
	}
	.page:last-child h2 {
		margin-top: 5mm;
		font-size: 18pt;
	}
	.page:last-child p {
		font-size: 10pt;
	}
	.page p {
		line-height: 1.5;
	}
	.plans th,
	.plans td {
		padding-block: 1.2mm;
	}
	.opportunities {
		gap: 4mm;
	}
	.metrics strong {
		font-size: 24pt;
	}
	.page:last-child th,
	.page:last-child td {
		padding-block: 1.8mm;
	}
	.page:last-child h2 {
		margin-top: 4mm;
	}

	.page:last-child .note {
		font-size: 8.5pt;
		line-height: 1.4;
	}
	.page:last-child table {
		font-size: 9.5pt;
		line-height: 1.4;
	}
	.page:last-child .contact {
		margin-block: 2mm;
	}
	.plan-table-scroll {
		overflow-x: auto;
		max-width: 100%;
	}
	@media screen and (max-width: 820px) {
		.plans {
			min-width: 580px;
		}
		.catalog-list article {
			grid-template-columns: 1fr;
		}
		.opportunities {
			grid-template-columns: 1fr;
		}
		.contact {
			font-size: 18pt;
		}
		header,
		footer {
			flex-wrap: wrap;
		}
	}
	@media print {
		.plan-table-scroll {
			overflow: visible;
		}
	}
	@page {
		size: A4;
		margin: 0;
	}
	@media print {
		body {
			background: white;
			print-color-adjust: exact;
			-webkit-print-color-adjust: exact;
		}
		.toolbar {
			display: none;
		}
		.page {
			margin: 0;
			height: 297mm;
			min-height: 0;
			break-after: page;
		}
		.page:last-child {
			break-after: auto;
		}
		a {
			text-decoration: none;
		}
	}
</style>
