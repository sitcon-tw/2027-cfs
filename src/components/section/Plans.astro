---
const { t, lang } = Astro.props;
import { Container, Check } from "@lucide/astro";
import planData from "@data/plan.json";
import { loadItemsData } from "../../utils/items-loader";
import { getBenefitLocalizedName } from "../../utils/plan-helper";
const itemsData = await loadItemsData(lang);

// Create a lookup map for quick item access by ID
const itemsMap = new Map(itemsData.map(item => [item.id, item]));

// Helper function to get earliest deadline from plan benefits
const getEarliestDeadline = (benefits: any[]) => {
	const deadlines = benefits.map(b => (b.item_id ? itemsMap.get(b.item_id)?.deadline : null)).filter((d): d is string => d !== null && d !== undefined && d !== "");

	if (deadlines.length === 0) return "";

	// Sort deadlines and return the earliest one
	return deadlines.sort((a, b) => new Date(a).getTime() - new Date(b).getTime())[0];
};

// Transform plan.json data to match the table structure
const tiers = [
	{
		id: "navigator",
		name: lang === "en" ? planData.navigator.name_en : planData.navigator.name_zh,
		price: planData.navigator.price,
		textColor: "#FF928A",
		deadline: getEarliestDeadline(planData.navigator.benefits)
	},
	{
		id: "deep_cultivation",
		name: lang === "en" ? planData.deep_cultivation.name_en : planData.deep_cultivation.name_zh,
		price: planData.deep_cultivation.price,
		textColor: "#537FF1",
		deadline: getEarliestDeadline(planData.deep_cultivation.benefits)
	},
	{
		id: "visionary",
		name: lang === "en" ? planData.visionary.name_en : planData.visionary.name_zh,
		price: planData.visionary.price,
		textColor: "#6FD195",
		deadline: getEarliestDeadline(planData.visionary.benefits)
	},
	{
		id: "new_sprout",
		name: lang === "en" ? planData.new_sprout.name_en : planData.new_sprout.name_zh,
		price: planData.new_sprout.price,
		textColor: "#77B55A",
		deadline: getEarliestDeadline(planData.new_sprout.benefits)
	}
];

// Create rows from benefits (assuming all tiers have the same items in same order)
const maxBenefits = Math.max(planData.navigator.benefits.length, planData.deep_cultivation.benefits.length, planData.visionary.benefits.length, planData.new_sprout.benefits.length);

// Helper function to generate fallback row IDs
const getFallbackRowId = (index: number) => `row-${index}`;

const rows: {
	id: string;
	name: string;
	isAvailable: boolean;
	values: { itemId: string; quantity: string; name: string }[];
}[] = [];
for (let i = 0; i < maxBenefits; i++) {
	const navBenefit = planData.navigator.benefits[i];
	const deepBenefit = planData.deep_cultivation.benefits[i];
	const visBenefit = planData.visionary.benefits[i];
	const sproutBenefit = planData.new_sprout.benefits[i];

	// Use the first available item_id as the row id
	const rowId = navBenefit?.item_id || deepBenefit?.item_id || visBenefit?.item_id || sproutBenefit?.item_id || getFallbackRowId(i);

	// Check if the item exists in the items data
	const itemExists = rowId !== getFallbackRowId(i) && itemsMap.has(rowId);

	// Check if any tier has a non-empty quantity AND the item exists in items data
	const hasAnyAvailableItem =
		itemExists &&
		!!(
			(navBenefit?.quantity && navBenefit.quantity !== "") ||
			(deepBenefit?.quantity && deepBenefit.quantity !== "") ||
			(visBenefit?.quantity && visBenefit.quantity !== "") ||
			(sproutBenefit?.quantity && sproutBenefit.quantity !== "")
		);

	// Get localized names for each benefit
	const navName = navBenefit ? getBenefitLocalizedName(navBenefit, lang) : "";
	const deepName = deepBenefit ? getBenefitLocalizedName(deepBenefit, lang) : "";
	const visName = visBenefit ? getBenefitLocalizedName(visBenefit, lang) : "";
	const sproutName = sproutBenefit ? getBenefitLocalizedName(sproutBenefit, lang) : "";

	rows.push({
		id: rowId,
		name: navName || deepName || visName || sproutName || "",
		isAvailable: hasAnyAvailableItem,
		values: [
			{ itemId: navBenefit?.item_id || "", quantity: navBenefit?.quantity || "", name: navName },
			{ itemId: deepBenefit?.item_id || "", quantity: deepBenefit?.quantity || "", name: deepName },
			{ itemId: visBenefit?.item_id || "", quantity: visBenefit?.quantity || "", name: visName },
			{ itemId: sproutBenefit?.item_id || "", quantity: sproutBenefit?.quantity || "", name: sproutName }
		]
	});
}

// Collect all unique item IDs from plan.json benefits
const uniqueItemIds = new Set<string>();

[planData.navigator, planData.deep_cultivation, planData.visionary, planData.new_sprout].forEach(tier => {
	tier.benefits.forEach(benefit => {
		if (benefit.item_id && benefit.item_id !== "") {
			uniqueItemIds.add(benefit.item_id);
		}
	});
});
---

<section id="plans">
	<h2 id="plans-title">{t.title}</h2>
	<div class="mobile-plan-summary">
		{
			tiers.map(tier => (
				<div>
					<>
						<strong>{tier.name}</strong>
						<span>{tier.price}</span>
					</>
				</div>
			))
		}
	</div>
	<details class="plan-comparison" open>
		<summary>{lang === "en" ? "Compare all plan benefits" : "展開／收合完整方案比較"}</summary>
		<p class="scroll-hint">{t.scroll_hint}</p>
		<div class="container">
			<div class="plans-table" role="region" aria-labelledby="plans-title" tabindex="0">
				<div class="plans-content">
					<div class="plan-row plans-header">
						<div class="row-label header-label"></div>
						{
							tiers.map((tier: any) => (
								<div class="tier-column">
									<div class="tier-name" style={`color: ${tier.textColor}`}>
										{tier.name}
									</div>
									<div class="tier-price">{tier.price}</div>
									<button class="tier-interest-button" data-tier-name={tier.id} data-tier-title={tier.name} data-tier-price={tier.price} data-tier-deadline={tier.deadline || ""}>
										{t.interested}
									</button>
								</div>
							))
						}
					</div>
					{
						rows.map((row: any) => (
							<div class={`plan-row ${!row.isAvailable ? "disabled" : ""}`} data-row-id={row.id} data-is-available={row.isAvailable}>
								<div class="row-label">{row.name}</div>
								{row.values.map((value: any) => {
									const isAvailable = value.quantity && value.quantity !== "";
									const isCheckmark = value.quantity === "O" || value.quantity === "o";

									// Check if quantity is a pure number
									const isNumeric = isAvailable && !isNaN(Number(value.quantity));

									// Get item data for unit and name
									const itemData = value.itemId ? itemsMap.get(value.itemId) : null;
									const itemUnit = itemData?.unit ? t.unit[itemData.unit] || itemData.unit : "";

									// Special handling for item ID 28 (booth)
									const isBoothItem = value.itemId === "28";
									const shouldShowIcons = isBoothItem && isNumeric;
									const iconCount = shouldShowIcons ? parseInt(value.quantity, 10) : 0;

									// Build display text with unit
									let displayText = value.quantity;
									if (isNumeric && itemUnit) {
										displayText = `${value.quantity} ${itemUnit}`;
									} else if (!isAvailable) {
										displayText = "—";
									}

									return (
										<div class="plan-cell" data-item-id={value.itemId}>
											{isCheckmark ? (
												<div class="cell-main cell-check">
													<Check />
												</div>
											) : shouldShowIcons ? (
												<div class="cell-icon cell-main">
													{Array.from({ length: iconCount }).map((_, i) => (
														<Container key={i} />
													))}
												</div>
											) : isAvailable ? (
												<div class="cell-main cell-text">{displayText}</div>
											) : (
												<div class="cell-sub cell-none">{displayText}</div>
											)}
										</div>
									);
								})}
							</div>
						))
					}
				</div>
			</div>
		</div>
	</details>
</section>

<script>
	import { isItemInterested, addInterestedItem, removeInterestedItem, isDeadlinePassed, type InterestedItem } from "../../utils/local-storage.ts";
	import { openVenueDetails } from "../../utils/venue-linkify.ts";

	// Attach openVenueDetails to window for inline onclick handlers
	window.openVenueDetails = openVenueDetails;

	function updateHighlighting() {
		const planCells = document.querySelectorAll("#plans .plan-cell");
		planCells.forEach(cell => {
			const itemId = (cell as HTMLElement).getAttribute("data-item-id");
			if (itemId && itemId !== "") {
				const isHighlighted = isItemInterested(itemId);

				// Check if cell contains unavailable content
				const cellText = cell.textContent?.trim();
				const isUnavailable = cellText === "" || cellText === "—" || cellText === "-";

				if (isHighlighted && !isUnavailable) {
					cell.classList.add("highlighted");
				} else {
					cell.classList.remove("highlighted");
				}
			}
		});
	}

	function addRowClickHandlers() {
		const planRows = document.querySelectorAll("#plans [data-row-id]") as NodeListOf<HTMLElement>;
		planRows.forEach(row => {
			const rowIdStr = row.getAttribute("data-row-id");
			const isAvailable = row.getAttribute("data-is-available") === "true";

			// Only add click handlers and cursor to available rows
			if (rowIdStr && isAvailable) {
				row.style.cursor = "pointer";
				row.addEventListener("click", function (e) {
					e.stopPropagation();
					const popupId = `item-popup-${rowIdStr}`;
					window.popupCtrl(popupId, "open");
				});
			}
		});
	}

	function removeAllTierItems() {
		const interestedItems = JSON.parse(localStorage.getItem("interestItems") || "[]");
		const tierItems = interestedItems.filter((item: InterestedItem) => item.id.startsWith("tier-"));

		tierItems.forEach((tierItem: InterestedItem) => {
			removeInterestedItem(tierItem.id);
		});
	}

	function addTierInterestHandlers() {
		const tierButtons = document.querySelectorAll("#plans .tier-interest-button");
		tierButtons.forEach(button => {
			const tierName = button.getAttribute("data-tier-name");
			const tierTitle = button.getAttribute("data-tier-title");
			const tierDeadline = button.getAttribute("data-tier-deadline") || "";

			if (tierName && tierTitle) {
				button.addEventListener("click", function (e) {
					e.stopPropagation();

					// Check if deadline has passed
					if (isDeadlinePassed(tierDeadline)) {
						return; // Don't allow adding expired plans
					}

					const tierPrice = button.getAttribute("data-tier-price") || "";

					const tierItem = {
						id: `tier-${tierName}`,
						title: tierTitle,
						category: "plan",
						image: "",
						deadline: "",
						price: tierPrice
					};

					if (isItemInterested(tierItem.id)) {
						removeInterestedItem(tierItem.id);
						button.classList.remove("interested");
					} else {
						// Remove all other tier items first
						removeAllTierItems();
						// Then add the new tier
						addInterestedItem(tierItem);
						button.classList.add("interested");
					}
				});
			}
		});
	}

	function updateTierButtonStates() {
		const tierButtons = document.querySelectorAll("#plans .tier-interest-button");
		tierButtons.forEach(button => {
			const tierName = button.getAttribute("data-tier-name");
			const tierDeadline = button.getAttribute("data-tier-deadline") || "";

			// Check if deadline has passed
			const expired = isDeadlinePassed(tierDeadline);
			if (expired) {
				button.setAttribute("disabled", "true");
				button.classList.add("disabled");
			} else {
				button.removeAttribute("disabled");
				button.classList.remove("disabled");
			}

			if (tierName) {
				const tierId = `tier-${tierName}`;
				button.setAttribute("aria-pressed", String(isItemInterested(tierId)));
				if (isItemInterested(tierId)) {
					button.classList.add("interested");
				} else {
					button.classList.remove("interested");
				}
			}
		});
	}

	document.addEventListener("DOMContentLoaded", function () {
		updateHighlighting();
		addRowClickHandlers();
		addTierInterestHandlers();
		updateTierButtonStates();
	});

	window.addEventListener("itemsChange", function () {
		updateHighlighting();
		updateTierButtonStates();
	});
	document.addEventListener("interested-items-changed", function () {
		updateHighlighting();
		updateTierButtonStates();
	});
</script>

<style>
	section {
		background-color: var(--items-bg);
		padding: 5rem 2rem;
		break-inside: avoid;
	}
	.container {
		max-width: min(1200px, 100%);
		width: fit-content;
		border-radius: 2rem;
		background-color: var(--white);
		margin: 0 auto;
		padding: 2rem;
		flex: auto;
		display: flex;
		justify-content: center;
	}

	.plans-table {
		background-color: var(--white);
		border-radius: 2rem;
		overflow: clip;
		padding: 2rem;
	}

	.plans-header {
		padding-bottom: 1rem;
		align-items: stretch;
		position: sticky;
		top: 4rem;
		z-index: 2;
		background-color: var(--white);
	}

	.plans-header:hover {
		background-color: var(--white) !important;
	}

	.tier-column {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border-light);
		gap: 0.5rem;
	}

	.tier-name {
		font-size: 2.3rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
		line-height: 1.2;
		flex-grow: 1;
		display: flex;
		align-items: center;
	}

	.tier-price {
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--black);
		margin-bottom: 1rem;
	}

	.tier-interest-button {
		background: transparent;
		border: 1px solid var(--black);
		cursor: pointer;
		padding: 0.5rem 1rem;
		border-radius: 25px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
		margin: 0 auto;
		font-size: 0.9rem;
		color: var(--black);
		white-space: nowrap;
	}

	.tier-interest-button:hover {
		background-color: var(--gray-container);
		transform: scale(1.02);
	}

	.tier-interest-button.interested {
		background-color: var(--items-green);
		border-color: var(--items-green);
		color: var(--white);
	}

	.tier-interest-button.interested:hover {
		background-color: var(--items-green);
		opacity: 0.9;
	}

	.tier-interest-button:disabled,
	.tier-interest-button.disabled {
		background-color: var(--gray);
		border-color: var(--gray);
		cursor: not-allowed;
		opacity: 0.5;
		color: var(--white);
	}

	.tier-interest-button:disabled:hover,
	.tier-interest-button.disabled:hover {
		transform: none;
		background-color: var(--gray);
	}

	.plans-content {
		display: grid;
		gap: 1rem;
	}

	.plan-row {
		display: grid;
		grid-template-columns: minmax(11rem, 1.6fr) repeat(4, 1fr);
		gap: 1.5rem;
		padding: 0.75rem 1.5rem;
		align-items: center;
	}

	.row-label {
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.4;
		color: var(--black);
		text-align: left;
	}

	.plans-header .header-label {
		border-bottom: 1px solid var(--border-light);
		align-self: stretch;
	}

	.cell-check svg {
		width: 1.5rem;
		height: 1.5rem;
		stroke-width: 3;
	}

	.cell-none {
		color: var(--gray);
	}

	.plan-cell {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 2.5rem;
	}

	.plan-row:not(.disabled):hover .row-label {
		color: var(--items-green);
	}

	.plan-cell.highlighted .cell-main,
	.plan-cell.highlighted .cell-sub,
	.plan-cell.highlighted .cell-check,
	.plan-cell.highlighted .cell-icon {
		color: var(--items-green);
		font-weight: 600;
	}

	.cell-icon {
		display: flex;
		gap: 0.25rem;
		justify-content: center;
	}

	.cell-icon svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	.cell-main {
		line-height: 1.3;
	}

	.cell-number {
		font-size: 2rem;
		font-weight: bold;
		color: var(--black);
	}

	.cell-text {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--black);
		white-space: nowrap;
	}

	.cell-sub {
		font-size: 1rem;
		color: var(--black);
		line-height: 1.5;
		text-wrap: balance;
	}

	.scroll-hint {
		display: none;
	}

	@media screen and (max-width: 1024px) {
		.container {
			width: 100%;
			padding: 1rem;
		}

		.scroll-hint {
			display: block;
			margin: -1rem 0 1rem;
			text-align: center;
			font-size: 0.9rem;
		}

		.plans-table {
			width: 100%;
			min-width: 0;
			overflow-x: auto;
			padding: 1rem;
		}

		.plans-content {
			min-width: 800px;
		}

		.plan-row {
			grid-template-columns: 10rem repeat(4, minmax(0, 1fr));
			gap: 1rem;
			padding: 0.75rem 0.5rem;
		}

		.tier-name {
			font-size: 1.5rem;
		}

		.tier-price {
			font-size: 1.25rem;
		}

		.tier-interest-button {
			min-height: 44px;
			font-size: 0.9rem;
			padding: 0.5rem 1rem;
		}

		/* Scroll the entire comparison together, including the item descriptions. */
		.plans-header {
			position: static;
		}
	}

	@media screen and (max-width: 768px) {
		section {
			padding: 3rem 1rem;
		}

		.container {
			padding: 0;
		}

		.plans-table {
			border-radius: 1.25rem;
		}
	}

	/* Plan row hover effect */
	.plan-row:not(.disabled):hover {
		background-color: var(--items-bg);
		border-radius: 0.5rem;
		transition: background-color 0.2s ease;
	}

	/* Disabled row styles */
	.plan-row.disabled {
		cursor: default !important;
	}

	.plan-row.disabled .plan-cell {
		pointer-events: none;
	}

	@media print {
		section {
			padding: 2rem;
		}

		.container {
			width: 100%;
			padding: 16pt;
			background-color: transparent;
		}
		.plans-table {
			max-width: unset;
			padding: 24pt;
		}

		.tier-name {
			font-size: 16pt;
			margin-bottom: 0;
			line-height: 1;
		}

		.tier-price {
			font-size: 12pt;
		}

		.tier-interest-button {
			display: none;
		}

		.tier-column {
			padding-bottom: 0;
		}

		.plan-row {
			padding: 0;
		}

		.cell-text {
			font-size: 12pt;
		}

		.row-label {
			font-size: 10pt;
		}
		.cell-sub {
			font-size: 10pt;
		}

		.plans-content {
			gap: 8pt;
		}
	}

	/* Venue link styles */
	.venue-link {
		color: #0171e3;
		text-decoration: underline;
		text-decoration-style: dotted;
		text-underline-offset: 2px;
		cursor: pointer;
		transition: all 0.2s ease;
		font-weight: 600;
	}

	.venue-link:hover {
		color: var(--items-green);
		text-decoration-style: solid;
	}

	/* Venue highlight animation */
	.venue-highlight {
		animation: venue-pulse 2s ease-in-out;
	}

	@keyframes venue-pulse {
		0%,
		100% {
			background-color: transparent;
		}
		50% {
			background-color: var(--items-green);
			color: var(--white);
			padding: 0.25rem 0.5rem;
			border-radius: 4px;
		}
	}

	@media print {
		.venue-link {
			text-decoration: none;
			font-weight: inherit;
		}
	}

	.mobile-plan-summary {
		display: none;
	}
	.plan-comparison summary {
		display: none;
		cursor: pointer;
		padding: 1rem;
		text-align: center;
		font-weight: bold;
	}
	@media screen and (max-width: 45rem) {
		.mobile-plan-summary {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.75rem;
			margin-bottom: 1rem;
		}
		.mobile-plan-summary > div {
			padding: 1rem;
			border: 1px solid #ddd;
			border-radius: 0.75rem;
		}
		.mobile-plan-summary strong,
		.mobile-plan-summary span {
			display: block;
		}
		.plan-comparison summary {
			display: block;
			border: 1px solid #ccc;
			border-radius: 0.75rem;
			margin-bottom: 1rem;
		}
	}
</style>

<script>
	const comparison = document.querySelector<HTMLDetailsElement>(".plan-comparison");
	const phone = window.matchMedia("(max-width: 45rem)");
	if (comparison) comparison.open = !phone.matches;
	phone.addEventListener("change", event => {
		if (comparison) comparison.open = !event.matches;
	});
</script>
