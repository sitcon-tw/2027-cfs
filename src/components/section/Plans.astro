---
const { t, lang } = Astro.props;
import { Container, Check } from "@lucide/astro";
import Button from "../Button.astro";
import planData from "@data/plan.json";
import { loadItemsData } from "../../utils/items-loader";
import { getBenefitLocalizedName, resolveBenefitItem } from "../../utils/plan-helper";
const itemsData = await loadItemsData(lang);

// Create a lookup map for quick item access by ID
const itemsMap = new Map(itemsData.map(item => [item.id, item]));

// Helper function to get earliest deadline from plan benefits
const getEarliestDeadline = (benefits: any[]) => {
	const deadlines = benefits.map(b => resolveBenefitItem(b)?.itemData.deadline).filter((d): d is string => d !== null && d !== undefined && d !== "");

	if (deadlines.length === 0) return "";

	// Sort deadlines and return the earliest one
	return deadlines.sort((a, b) => new Date(a).getTime() - new Date(b).getTime())[0];
};

// Transform plan.json data to match the table structure
const tiers = [
	{
		id: "navigator",
		name: lang === "en" ? planData.navigator.name_en : planData.navigator.name_zh,
		price: planData.navigator.price,
		textColor: "#FF928A",
		deadline: getEarliestDeadline(planData.navigator.benefits)
	},
	{
		id: "deep_cultivation",
		name: lang === "en" ? planData.deep_cultivation.name_en : planData.deep_cultivation.name_zh,
		price: planData.deep_cultivation.price,
		textColor: "#537FF1",
		deadline: getEarliestDeadline(planData.deep_cultivation.benefits)
	},
	{
		id: "visionary",
		name: lang === "en" ? planData.visionary.name_en : planData.visionary.name_zh,
		price: planData.visionary.price,
		textColor: "#6FD195",
		deadline: getEarliestDeadline(planData.visionary.benefits)
	},
	{
		id: "new_sprout",
		name: lang === "en" ? planData.new_sprout.name_en : planData.new_sprout.name_zh,
		price: planData.new_sprout.price,
		textColor: "#77B55A",
		deadline: getEarliestDeadline(planData.new_sprout.benefits)
	}
];

// All tiers share benefit order; use the same benefit resolution for display and interaction.
const tierPlans = tiers.map(tier => planData[tier.id as keyof typeof planData]);
const maxBenefits = Math.max(...tierPlans.map(tier => tier.benefits.length));
const rows = Array.from({ length: maxBenefits }, (_, index) => {
	const values = tierPlans.map(tier => {
		const benefit = tier.benefits[index];
		const resolved = benefit ? resolveBenefitItem(benefit) : null;
		const itemId = resolved?.itemId || "";
		return {
			itemId,
			popupItemId: itemId.split("-sub-")[0],
			quantity: benefit?.quantity || "",
			name: benefit ? getBenefitLocalizedName(benefit, lang) : ""
		};
	});
	const availableValue = values.find(value => value.popupItemId && value.quantity);
	return {
		id: values.find(value => value.itemId)?.itemId || `row-${index}`,
		name: values.find(value => value.name)?.name || "",
		popupItemId: availableValue?.popupItemId,
		values
	};
});
---

<section id="plans">
	<h2 id="plans-title">{t.title}</h2>
	<div class="plan-comparison">
		<div class="container" role="table" aria-labelledby="plans-title">
			<div class="plans-heading" role="rowgroup">
				<div class="plans-header-scroll lenis-scroll">
					<div class="plan-row plans-header" role="row">
						<div class="row-label header-label" role="columnheader">{lang === "en" ? "Benefits" : "贊助品項"}</div>
						{
							tiers.map((tier: any) => (
								<div class="tier-column" role="columnheader">
									<div class="tier-name" style={`color: ${tier.textColor}`}>
										{tier.name}
									</div>
									<div class="tier-price">{tier.price}</div>
								<Button variant="outlined" class="tier-interest-button" data-tier-name={tier.id} data-tier-title={tier.name} data-tier-price={tier.price} data-tier-deadline={tier.deadline || ""}>
									{t.interested}
								</Button>
								</div>
							))
						}
					</div>
				</div>
			</div>
			<div class="plans-table lenis-scroll" role="region" aria-labelledby="plans-title" tabindex="0">
				<div class="plans-content" role="rowgroup">
					{
						rows.map(row => (
							<div class="plan-row" data-row-id={row.id} data-popup-item-id={row.popupItemId} role="row">
								<div class="row-label" role="rowheader">
									{row.name}
								</div>
								{row.values.map(value => {
									const isAvailable = value.quantity && value.quantity !== "";
									const isCheckmark = value.quantity === "O" || value.quantity === "o";

									// Check if quantity is a pure number
									const isNumeric = isAvailable && !isNaN(Number(value.quantity));

									// Get item data for unit and name
									const itemData = value.itemId ? itemsMap.get(value.popupItemId) : null;
									const itemUnit = itemData?.unit ? t.unit[itemData.unit] || itemData.unit : "";

									// Special handling for item ID 28 (booth)
									const isBoothItem = value.itemId === "28";
									const shouldShowIcons = isBoothItem && isNumeric;
									const iconCount = shouldShowIcons ? parseInt(value.quantity, 10) : 0;

									// Build display text with unit
									let displayText = value.quantity;
									if (isNumeric && itemUnit) {
										displayText = `${value.quantity} ${itemUnit}`;
									} else if (!isAvailable) {
										displayText = "—";
									}

									return (
										<div class="plan-cell" data-item-id={value.itemId} role="cell">
											{isCheckmark ? (
												<div class="cell-main cell-check">
													<Check />
												</div>
											) : shouldShowIcons ? (
												<div class="cell-icon cell-main">
													{Array.from({ length: iconCount }).map((_, i) => (
														<Container key={i} />
													))}
												</div>
											) : isAvailable ? (
												<div class="cell-main cell-text">{displayText}</div>
											) : (
												<div class="cell-sub cell-none">{displayText}</div>
											)}
										</div>
									);
								})}
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { isItemInterested, addInterestedItem, removeInterestedItem, isDeadlinePassed, type InterestedItem } from "../../utils/local-storage.ts";
	import { openVenueDetails } from "../../utils/venue-linkify.ts";

	const plans = document.getElementById("plans");
	const headerScroll = plans?.querySelector<HTMLElement>(".plans-header-scroll");
	const benefitScroll = plans?.querySelector<HTMLElement>(".plans-table");
	if (headerScroll && benefitScroll) {
		// Keep both horizontal viewports aligned, without changing vertical page scrolling.
		for (const [source, target] of [
			[headerScroll, benefitScroll],
			[benefitScroll, headerScroll]
		]) {
			source.addEventListener(
				"scroll",
				() => {
					if (Math.abs(target.scrollLeft - source.scrollLeft) > 0.5) target.scrollLeft = source.scrollLeft;
				},
				{ passive: true }
			);
		}
		const container = plans?.querySelector<HTMLElement>(".container");
		let previousWidth = benefitScroll.clientWidth;
		let previousTierWidth = headerScroll.querySelector(".tier-column")!.getBoundingClientRect().width;
		if (container) {
			new ResizeObserver(() => {
				if (Math.abs(benefitScroll.clientWidth - previousWidth) < 0.5) return;
				const column = Math.round(benefitScroll.scrollLeft / previousTierWidth);
				const tierWidth = headerScroll.querySelector(".tier-column")!.getBoundingClientRect().width;
				// Keep complete plan columns visible when rotating the phone or resizing.
				benefitScroll.scrollLeft = column * tierWidth;
				headerScroll.scrollLeft = benefitScroll.scrollLeft;
				previousWidth = benefitScroll.clientWidth;
				previousTierWidth = tierWidth;
			}).observe(container);
		}
	}
	const navbar = document.querySelector<HTMLElement>(".navbar");
	if (navbar && plans) {
		const updateHeaderOffset = () => plans.style.setProperty("--plans-nav-offset", `${navbar.getBoundingClientRect().height}px`);
		updateHeaderOffset();
		new ResizeObserver(updateHeaderOffset).observe(navbar);
	}

	// Attach openVenueDetails to window for inline onclick handlers
	window.openVenueDetails = openVenueDetails;

	function updateHighlighting() {
		const planCells = document.querySelectorAll("#plans .plan-cell");
		planCells.forEach(cell => {
			const itemId = (cell as HTMLElement).getAttribute("data-item-id");
			if (itemId && itemId !== "") {
				const isHighlighted = isItemInterested(itemId);

				// Check if cell contains unavailable content
				const cellText = cell.textContent?.trim();
				const isUnavailable = cellText === "" || cellText === "—" || cellText === "-";

				if (isHighlighted && !isUnavailable) {
					cell.classList.add("highlighted");
				} else {
					cell.classList.remove("highlighted");
				}
			}
		});
	}

	function addRowClickHandlers() {
		const planRows = document.querySelectorAll<HTMLElement>("#plans [data-popup-item-id]");
		planRows.forEach(row => {
			row.addEventListener("click", e => {
				e.stopPropagation();
				window.popupCtrl(`item-popup-${row.dataset.popupItemId}`, "open");
			});
		});
	}

	function removeAllTierItems() {
		const interestedItems = JSON.parse(localStorage.getItem("interestItems") || "[]");
		const tierItems = interestedItems.filter((item: InterestedItem) => item.id.startsWith("tier-"));

		tierItems.forEach((tierItem: InterestedItem) => {
			removeInterestedItem(tierItem.id);
		});
	}

	function addTierInterestHandlers() {
		const tierButtons = document.querySelectorAll("#plans .tier-interest-button");
		tierButtons.forEach(button => {
			const tierName = button.getAttribute("data-tier-name");
			const tierTitle = button.getAttribute("data-tier-title");
			const tierDeadline = button.getAttribute("data-tier-deadline") || "";

			if (tierName && tierTitle) {
				button.addEventListener("click", function (e) {
					e.stopPropagation();

					// Check if deadline has passed
					if (isDeadlinePassed(tierDeadline)) {
						return; // Don't allow adding expired plans
					}

					const tierPrice = button.getAttribute("data-tier-price") || "";

					const tierItem = {
						id: `tier-${tierName}`,
						title: tierTitle,
						category: "plan",
						image: "",
						deadline: "",
						price: tierPrice
					};

					if (isItemInterested(tierItem.id)) {
						removeInterestedItem(tierItem.id);
						button.classList.remove("interested");
					} else {
						// Remove all other tier items first
						removeAllTierItems();
						// Then add the new tier
						addInterestedItem(tierItem);
						button.classList.add("interested");
					}
				});
			}
		});
	}

	function updateTierButtonStates() {
		const tierButtons = document.querySelectorAll("#plans .tier-interest-button");
		tierButtons.forEach(button => {
			const tierName = button.getAttribute("data-tier-name");
			const tierDeadline = button.getAttribute("data-tier-deadline") || "";

			// Check if deadline has passed
			const expired = isDeadlinePassed(tierDeadline);
			if (expired) {
				button.setAttribute("disabled", "true");
				button.classList.add("disabled");
			} else {
				button.removeAttribute("disabled");
				button.classList.remove("disabled");
			}

			if (tierName) {
				const tierId = `tier-${tierName}`;
				button.setAttribute("aria-pressed", String(isItemInterested(tierId)));
				if (isItemInterested(tierId)) {
					button.classList.add("interested");
				} else {
					button.classList.remove("interested");
				}
			}
		});
	}

	document.addEventListener("DOMContentLoaded", function () {
		updateHighlighting();
		addRowClickHandlers();
		addTierInterestHandlers();
		updateTierButtonStates();
	});

	window.addEventListener("itemsChange", function () {
		updateHighlighting();
		updateTierButtonStates();
	});
	document.addEventListener("interested-items-changed", function () {
		updateHighlighting();
		updateTierButtonStates();
	});
</script>

<style>
	section {
		background-color: var(--items-bg);
		padding: 4rem 2rem;
		break-inside: avoid;
	}
	#plans-title {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		margin-bottom: 1.5rem;
	}
	.container {
		container-type: inline-size;
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		background: var(--white);
		border-radius: 1rem;
		--label-width: clamp(10rem, 24cqw, 15rem);
		--tier-width: calc((100cqw - var(--label-width)) / 4);
	}
	.plans-table,
	.plans-header-scroll {
		width: 100%;
		overflow-x: auto;
		overscroll-behavior-x: contain;
	}
	.plans-table {
		border-radius: 0 0 1rem 1rem;
	}
	.plans-heading {
		position: sticky;
		top: var(--plans-nav-offset, 4rem);
		z-index: 3;
		background: var(--white);
		border-radius: 1rem 1rem 0 0;
		box-shadow: 0 1px 0 var(--border-light);
	}
	.plans-header-scroll {
		border-radius: inherit;
		scrollbar-width: none;
	}
	.plans-header-scroll::-webkit-scrollbar {
		display: none;
	}

	.plans-table:focus-visible {
		outline: 2px solid #14693e;
		outline-offset: 3px;
	}
	.plans-content,
	.plans-header {
		width: calc(var(--label-width) + 4 * var(--tier-width));
	}
	.plan-row {
		display: grid;
		grid-template-columns: var(--label-width) repeat(4, var(--tier-width));
		align-items: stretch;
		border-bottom: 1px solid #e8e8ec;
	}
	.plan-row:last-child {
		border-bottom: 0;
	}
	.row-label {
		position: sticky;
		left: 0;
		z-index: 2;
		display: flex;
		align-items: center;
		padding: 0.875rem 1.25rem;
		background: var(--white);
		box-shadow: 1px 0 0 var(--border-light);
		font-size: 0.9375rem;
		font-weight: 500;
		line-height: 1.5;
		color: var(--black);
		text-align: left;
		overflow-wrap: anywhere;
	}
	.header-label {
		font-weight: 700;
		align-items: flex-start;
		padding-top: 1.25rem;
	}
	.tier-column {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 1.25rem 0.75rem;
		text-align: center;
		min-width: 0;
	}
	.tier-name {
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.25;
		flex: 1;
		display: flex;
		align-items: center;
		overflow-wrap: anywhere;
	}
	.tier-price {
		font-size: 1.125rem;
		font-weight: 600;
		white-space: nowrap;
	}
	#plans :global(.site-button.tier-interest-button.interested) {
		background: #14693e;
		border-color: #14693e;
		color: white;
	}
	#plans :global(.site-button.tier-interest-button:disabled) {
		background: var(--gray);
		border-color: var(--gray);
		color: white;
	}
	.plan-cell {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.875rem 0.5rem;
		min-height: 3.5rem;
		min-width: 0;
		text-align: center;
	}
	.cell-main {
		line-height: 1.4;
	}
	.cell-text {
		font-size: 1.0625rem;
		font-weight: 600;
		overflow-wrap: anywhere;
	}
	.cell-check svg {
		width: 1.25rem;
		height: 1.25rem;
		stroke-width: 3;
	}
	.cell-icon {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		justify-content: center;
	}
	.cell-icon svg {
		width: 1.25rem;
		height: 1.25rem;
	}
	.cell-none {
		color: var(--gray);
	}
	.plan-cell.highlighted {
		color: #14693e;
		font-weight: 600;
	}
	.plan-row[data-popup-item-id]:hover,
	.plan-row[data-popup-item-id]:hover .row-label {
		background: #eff6ee;
	}
	.plan-row[data-popup-item-id] {
		cursor: pointer;
	}
	@media screen and (max-width: 900px) {
		section {
			padding: 3rem 1rem;
		}
		.container {
			--label-width: clamp(6.25rem, 30cqw, 8rem);
			--tier-width: calc((100cqw - var(--label-width)) / 2);
		}
		.row-label {
			font-size: 0.875rem;
			padding: 0.75rem 0.625rem 0.75rem 0.875rem;
		}
		:global(html[lang="en"]) .row-label {
			font-size: 0.8125rem;
			hyphens: auto;
		}
		.header-label {
			padding-top: 1rem;
		}
		.tier-column {
			padding: 0.875rem 0.375rem;
			gap: 0.4rem;
		}
		.tier-name {
			font-size: clamp(0.875rem, 4cqw, 1.125rem);
		}
		.tier-price {
			font-size: 0.8125rem;
		}
		:global(.tier-interest-button) {
			font-size: 0.8125rem;
			padding: 0.25rem 0.625rem;
		}
		.plan-cell {
			padding: 0.75rem 0.375rem;
		}
		.cell-text {
			font-size: 0.9375rem;
		}
	}
	@media print {
		section {
			padding: 2rem;
		}
		.container {
			--label-width: 24cqw;
			--tier-width: 19cqw;
		}
		.plans-table,
		.plans-header-scroll {
			overflow: visible;
		}
		.plans-heading,
		.row-label {
			position: static;
			box-shadow: none;
		}
		:global(.tier-interest-button) {
			display: none;
		}
		.tier-name {
			font-size: 16pt;
		}
		.tier-price,
		.cell-text {
			font-size: 12pt;
		}
		.row-label {
			font-size: 10pt;
		}
	}
</style>
