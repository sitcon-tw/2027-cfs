---
import Popup from "@components/Popup.astro";
import { ArrowUpRight } from "@lucide/astro";
import president2026 from "@assets/img/news/president2026.webp";
import cna2026 from "@assets/img/news/cna2026.webp";
import udn2026 from "@assets/img/news/udn2026.webp";
import moe2026 from "@assets/img/news/moe2026.webp";
import agileAwards2026 from "@assets/img/news/agile-awards2026.webp";
import muchtv2026 from "@assets/img/news/muchtv2026.webp";
import hk from "@assets/img/sitcon_hk.webp";
import groups from "@assets/img/groups.webp";
import edu from "@assets/img/edu.webp";
import hackathon from "@assets/img/hackathon.webp";
import camp from "@assets/img/camp.webp";
import type { ImageMetadata } from "astro";
import community from "@assets/img/news/community-hero.webp";

const { t, lang } = Astro.props;
type News = {
	img: ImageMetadata;
	title: string;
	description: string;
};
const news: News[] = [
	{
		img: hk,
		title: t.things[0].title,
		description: t.things[0].description
	},
	{
		img: groups,
		title: t.things[1].title,
		description: t.things[1].description
	},
	{
		img: edu,
		title: t.things[2].title,
		description: t.things[2].description
	},
	{
		img: hackathon,
		title: t.things[3].title,
		description: t.things[3].description
	},
	{
		img: camp,
		title: t.things[4].title,
		description: t.things[4].description
	}
];

type Coverage = {
	href: string;
	img: ImageMetadata;
};
const coverage: Coverage[] = [
	{ href: "https://www.president.gov.tw/News/39930", img: president2026 },
	{ href: "https://www.cna.com.tw/news/aipl/202603280032.aspx", img: cna2026 },
	{ href: "https://money.udn.com/money/story/7307/9408273", img: udn2026 },
	{ href: "https://www.edu.tw/News_Content.aspx?n=9E7AC85F1954DDA8&s=44FFA988115FABF4", img: moe2026 },
	{ href: "https://act.club.tw/act-taiwan-agile-awards-2026/#winners-agile-org", img: agileAwards2026 },
	{ href: "https://www.youtube.com/watch?v=zplk0zALtOM", img: muchtv2026 }
];
---

<section id="news">
	<h2>{t.recognition_title}</h2>
	<div class="news-content wrap" role="region" aria-label={t.coverage_title || "媒體報導"} tabindex="0">
		{
			coverage.map((item, index) => (
				<a class="news-card" target="_blank" rel="noopener noreferrer" href={item.href}>
					<div class="news-media">
						<img src={item.img.src} width={item.img.width} height={item.img.height} alt={t.coverage[index].alt} class="news-img" loading="lazy" />
					</div>
					<div class="news-meta">
						<span class="news-source">
							{t.coverage[index].source}
							<ArrowUpRight size={16} aria-hidden="true" />
						</span>
					</div>
				</a>
			))
		}
	</div>
	<Popup title={t.title} background={community.src} btnText={t.btn} id="news-popup" lang={lang}>
		<div class="things-container">
			{
				news.map((item, index) => (
					<section class="things-section" aria-labelledby={`thing-title-${index}`}>
						<div class="things-text-container">
							<div class="things-text">
								<h3 id={`thing-title-${index}`}>{item.title}</h3>
								<p>{item.description}</p>
							</div>
						</div>
						<img src={item.img.src} width={item.img.width} height={item.img.height} alt={item.title} class="things-img" loading="lazy" />
					</section>
				))
			}
			<p class="photo-credit">
				<a href="https://www.flickr.com/photos/sitcon/55472524973" target="_blank" rel="noopener noreferrer">SITCON 2027 × COSCUP BoF · 康喔</a>
				· <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>
			</p>
		</div>
	</Popup>
</section>

<style>
	#news {
		padding: 3rem 0;
	}
	.news-content {
		padding-block: 1rem 3rem;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
	}
	/* Same card language as the highlight cards: soft container, 1rem radius. */
	.news-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		background-color: var(--container);
		border-radius: 1rem;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
		transition: background-color 0.25s ease;
	}
	.news-media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background-color: var(--gray-container);
	}
	.news-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 0.45s ease;
	}
	/* Hover stays inside the card: the photo creeps in and the arrow points the way, nothing lifts. */
	@media (hover: hover) {
		.news-card:hover {
			background-color: var(--gray-container);
		}
		.news-card:hover .news-img {
			transform: scale(1.04);
		}
		.news-card:hover .news-source svg {
			transform: translate(2px, -2px);
			color: var(--black);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.news-img,
		.news-source svg {
			transition: none;
		}
		.news-card:hover .news-img {
			transform: none;
		}
	}
	.news-meta {
		padding: 1rem 1.25rem 1.25rem;
	}
	.news-source {
		display: flex;
		align-items: flex-start;
		gap: 0.3rem;
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.4;
	}
	.news-source svg {
		flex-shrink: 0;
		margin-top: 0.2em;
		color: var(--gray);
		transition:
			transform 0.25s ease,
			color 0.25s ease;
	}
	#news :global(.detail-btn) {
		position: static;
	}
	@media screen and (max-width: 60rem) {
		.news-content {
			display: flex;
			overflow-x: auto;
			/* Undo .wrap: the track bleeds to the viewport edges, but the first and last card still start and end on the shared gutter. */
			width: auto;
			margin-inline: 0;
			padding: 1rem var(--page-gutter) 2rem;
			scroll-padding-inline: var(--page-gutter);
			gap: 1rem;
		}
		.news-card {
			flex: 0 0 min(78vw, 22rem);
		}
	}

	/* Follow the alternating venue rows in the activity details dialog. */
	.things-container {
		padding-top: 2rem;
	}

	.things-section {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1rem;
		break-inside: avoid;
	}

	.things-section:nth-child(even) {
		flex-direction: row-reverse;
	}

	.things-text-container {
		padding: 2rem;
		flex: 1;
		min-width: 0;
	}

	.things-text {
		max-width: 20rem;
		margin: auto;
	}

	.things-text h3 {
		font-size: 1.8rem;
		line-height: 1.4;
		margin-bottom: 1rem;
	}

	.things-text p {
		white-space: pre-line;
		color: var(--gray);
		line-height: 1.6;
	}

	.things-img {
		display: block;
		width: 0;
		height: 20rem;
		object-fit: cover;
		background-color: var(--gray-container);
		border-radius: 1.5rem 0 0 1.5rem;
		min-width: 0;
		flex: 1;
	}

	.things-section:nth-child(even) .things-img {
		border-radius: 0 1.5rem 1.5rem 0;
	}

	.photo-credit {
		margin: 2rem 2rem 0;
		text-align: center;
		font-size: 0.75rem;
		color: var(--gray);
		line-height: 1.6;
	}

	.photo-credit a {
		color: inherit;
		text-underline-offset: 0.2em;
	}

	@media screen and (max-width: 42rem) {
		.things-container {
			padding-top: 0;
		}

		.things-section {
			display: block;
		}

		.things-text-container {
			padding: 2rem 2rem 1rem;
		}

		.things-text {
			max-width: unset;
		}

		.things-img,
		.things-section:nth-child(even) .things-img {
			border-radius: 1.5rem;
			margin: 0 2rem;
			height: 10rem;
			width: calc(100% - 4rem);
		}
	}

	@media print {
		.news-content {
			max-width: 800px;
		}

		.things-img {
			height: 180pt;
		}
	}
</style>

<script>
	const newsTrack = document.querySelector<HTMLElement>("#news .news-content");
	if (newsTrack) {
		const mobile = window.matchMedia("(max-width: 60rem)");
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let visible = false;
		let userControlled = false;
		let frame = 0;
		let previousTime = 0;
		let position = 0;

		function stop() {
			cancelAnimationFrame(frame);
			frame = 0;
			previousTime = 0;
		}
		function advance(time: number) {
			if (!newsTrack) return;
			const limit = newsTrack.scrollWidth - newsTrack.clientWidth;
			if (previousTime) position += Math.min(time - previousTime, 64) * 0.02;
			previousTime = time;
			newsTrack.scrollLeft = Math.min(position, limit);
			if (position >= limit) stop();
			else frame = requestAnimationFrame(advance);
		}
		function updatePlayback() {
			stop();
			if (!newsTrack || !visible || userControlled || !mobile.matches || reducedMotion.matches || document.hidden || document.querySelector(".popup-bg.show")) return;
			position = newsTrack.scrollLeft;
			if (position < newsTrack.scrollWidth - newsTrack.clientWidth) frame = requestAnimationFrame(advance);
		}
		function takeControl() {
			// Once someone starts reading or swiping, leave the position in their hands.
			userControlled = true;
			stop();
		}
		for (const event of ["pointerdown", "wheel", "keydown", "focusin"]) {
			newsTrack.addEventListener(event, takeControl, { passive: true });
		}
		new IntersectionObserver(
			([entry]) => {
				visible = entry.intersectionRatio >= 0.1;
				updatePlayback();
			},
			{ threshold: [0, 0.1] }
		).observe(newsTrack);
		mobile.addEventListener("change", updatePlayback);
		reducedMotion.addEventListener("change", updatePlayback);
		document.addEventListener("visibilitychange", updatePlayback);
		document.addEventListener("popupOpened", stop);
		document.addEventListener("popupClosed", updatePlayback);
	}
</script>
