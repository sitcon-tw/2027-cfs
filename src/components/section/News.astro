---
import Popup from "@components/Popup.astro";
import president2026 from "@assets/img/news/president2026.webp";
import cna2026 from "@assets/img/news/cna2026.webp";
import udn2026 from "@assets/img/news/udn2026.webp";
import moe2026 from "@assets/img/news/moe2026.webp";
import agileAwards2026 from "@assets/img/news/agile-awards2026.webp";
import muchtv2026 from "@assets/img/news/muchtv2026.webp";
import hk from "@assets/img/sitcon_hk.webp";
import groups from "@assets/img/groups.webp";
import edu from "@assets/img/edu.webp";
import hackathon from "@assets/img/hackathon.webp";
import camp from "@assets/img/camp.webp";
import type { ImageMetadata } from "astro";
import community from "@assets/img/news/community-hero.webp";

const { t } = Astro.props;
type News = {
	img: ImageMetadata;
	title: string;
	description: string;
};
const news: News[] = [
	{
		img: hk,
		title: t.things[0].title,
		description: t.things[0].description
	},
	{
		img: groups,
		title: t.things[1].title,
		description: t.things[1].description
	},
	{
		img: edu,
		title: t.things[2].title,
		description: t.things[2].description
	},
	{
		img: hackathon,
		title: t.things[3].title,
		description: t.things[3].description
	},
	{
		img: camp,
		title: t.things[4].title,
		description: t.things[4].description
	}
];
---

<section id="news">
	<h2>SITCON 榮獲各界肯定</h2>
	<div class="news-content" role="region" aria-label={t.coverage_title || "媒體報導"} tabindex="0">
		<a target="_blank" rel="noopener noreferrer" href="https://www.president.gov.tw/News/39930">
			<span class="news-source">總統府</span><img src={president2026.src} width={president2026.width} height={president2026.height} alt="總統府 · SITCON 2026" class="news-img" loading="lazy" />
		</a>
		<a target="_blank" rel="noopener noreferrer" href="https://www.cna.com.tw/news/aipl/202603280032.aspx">
			<span class="news-source">中央社 CNA</span><img src={cna2026.src} width={cna2026.width} height={cna2026.height} alt="中央社 · SITCON 2026" class="news-img" loading="lazy" />
		</a>
		<a target="_blank" rel="noopener noreferrer" href="https://money.udn.com/money/story/7307/9408273">
			<span class="news-source">經濟日報</span><img src={udn2026.src} width={udn2026.width} height={udn2026.height} alt="經濟日報 · SITCON 2026" class="news-img" loading="lazy" />
		</a>
		<a target="_blank" rel="noopener noreferrer" href="https://www.edu.tw/News_Content.aspx?n=9E7AC85F1954DDA8&amp;s=44FFA988115FABF4">
			<span class="news-source">教育部青年發展署</span><img src={moe2026.src} width={moe2026.width} height={moe2026.height} alt="SITCON 團隊於第 3 屆青志獎獲獎合影" class="news-img" loading="lazy" />
		</a>
		<a target="_blank" rel="noopener noreferrer" href="https://act.club.tw/act-taiwan-agile-awards-2026/#winners-agile-org">
			<span class="news-source">台灣敏捷協會｜2026 台灣敏捷大賞</span><img
				src={agileAwards2026.src}
				width={agileAwards2026.width}
				height={agileAwards2026.height}
				alt="SITCON 團隊獲 2026 台灣敏捷大賞年度敏捷組織獎合影"
				class="news-img"
				loading="lazy"
			/>
		</a>
		<a target="_blank" rel="noopener noreferrer" href="https://www.youtube.com/watch?v=zplk0zALtOM">
			<span class="news-source">年代 MUCH｜台灣新驕點</span><img
				src={muchtv2026.src}
				width={muchtv2026.width}
				height={muchtv2026.height}
				alt="年代新聞 · SITCON 2026"
				class="news-img"
				loading="lazy"
			/>
		</a>
	</div>
	<Popup title={t.title} background={community.src} btnText={t.btn} id="news-popup">
		<div class="things-container">
			{
				news.map((item, index) => (
					<section class="things-section" aria-labelledby={`thing-title-${index}`}>
						<div class="things-text-container">
							<div class="things-text">
								<h3 id={`thing-title-${index}`}>{item.title}</h3>
								<p>{item.description}</p>
							</div>
						</div>
						<img src={item.img.src} width={item.img.width} height={item.img.height} alt={item.title} class="things-img" loading="lazy" />
					</section>
				))
			}
			<p class="photo-credit">
				<a href="https://www.flickr.com/photos/sitcon/55472524973" target="_blank" rel="noopener noreferrer">SITCON 2027 × COSCUP BoF · 康喔</a>
				· <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>
			</p>
		</div>
	</Popup>
</section>

<style>
	#news {
		padding: 3rem 0;
	}
	.news-content {
		max-width: 1100px;
		margin: auto;
		padding: 1rem 2rem 3rem;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
		align-items: start;
	}
	.news-content a {
		display: block;
		min-width: 0;
	}
	.news-content a:nth-child(3n + 2) {
		transform: translateY(1rem);
	}
	.news-source {
		display: block;
		margin-bottom: 0.5rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: #333;
	}
	.news-img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: cover;
		object-position: top;
		box-shadow: 0 5px 20px #0002;
		border-radius: 0.4rem;
	}
	#news :global(.detail-btn) {
		position: static;
	}
	@media screen and (max-width: 60rem) {
		.news-content {
			display: flex;
			overflow-x: auto;
			padding: 1rem 1.5rem 2rem;
			gap: 1rem;
		}
		.news-content a {
			flex: 0 0 min(85vw, 28rem);
		}
		.news-content a:nth-child(3n + 2) {
			transform: none;
		}
		.news-img {
			height: 22rem;
		}
	}

	/* Follow the alternating venue rows in the activity details dialog. */
	.things-container {
		padding-top: 2rem;
	}

	.things-section {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1rem;
		break-inside: avoid;
	}

	.things-section:nth-child(even) {
		flex-direction: row-reverse;
	}

	.things-text-container {
		padding: 2rem;
		flex: 1;
		min-width: 0;
	}

	.things-text {
		max-width: 20rem;
		margin: auto;
	}

	.things-text h3 {
		font-size: 1.8rem;
		line-height: 1.4;
		margin-bottom: 1rem;
	}

	.things-text p {
		white-space: pre-line;
		color: var(--gray);
		line-height: 1.6;
	}

	.things-img {
		display: block;
		width: 0;
		height: 20rem;
		object-fit: cover;
		background-color: var(--gray-container);
		border-radius: 1.5rem 0 0 1.5rem;
		min-width: 0;
		flex: 1;
	}

	.things-section:nth-child(even) .things-img {
		border-radius: 0 1.5rem 1.5rem 0;
	}

	.photo-credit {
		margin: 2rem 2rem 0;
		text-align: center;
		font-size: 0.75rem;
		color: var(--gray);
		line-height: 1.6;
	}

	.photo-credit a {
		color: inherit;
		text-underline-offset: 0.2em;
	}

	@media screen and (max-width: 42rem) {
		.things-container {
			padding-top: 0;
		}

		.things-section {
			display: block;
		}

		.things-text-container {
			padding: 2rem 2rem 1rem;
		}

		.things-text {
			max-width: unset;
		}

		.things-img,
		.things-section:nth-child(even) .things-img {
			border-radius: 1.5rem;
			margin: 0 2rem;
			height: 10rem;
			width: calc(100% - 4rem);
		}
	}

	@media print {
		.news-content {
			max-width: 800px;
		}

		.things-img {
			height: 180pt;
		}
	}
</style>

<script>
	const newsTrack = document.querySelector<HTMLElement>("#news .news-content");
	if (newsTrack) {
		const mobile = window.matchMedia("(max-width: 60rem)");
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let visible = false;
		let userControlled = false;
		let frame = 0;
		let previousTime = 0;
		let position = 0;

		function stop() {
			cancelAnimationFrame(frame);
			frame = 0;
			previousTime = 0;
		}
		function advance(time: number) {
			if (!newsTrack) return;
			const limit = newsTrack.scrollWidth - newsTrack.clientWidth;
			if (previousTime) position += Math.min(time - previousTime, 64) * 0.02;
			previousTime = time;
			newsTrack.scrollLeft = Math.min(position, limit);
			if (position >= limit) stop();
			else frame = requestAnimationFrame(advance);
		}
		function updatePlayback() {
			stop();
			if (!newsTrack || !visible || userControlled || !mobile.matches || reducedMotion.matches || document.hidden || document.querySelector(".popup-bg.show")) return;
			position = newsTrack.scrollLeft;
			if (position < newsTrack.scrollWidth - newsTrack.clientWidth) frame = requestAnimationFrame(advance);
		}
		function takeControl() {
			// Once someone starts reading or swiping, leave the position in their hands.
			userControlled = true;
			stop();
		}
		for (const event of ["pointerdown", "wheel", "keydown", "focusin"]) {
			newsTrack.addEventListener(event, takeControl, { passive: true });
		}
		new IntersectionObserver(
			([entry]) => {
				visible = entry.intersectionRatio >= 0.1;
				updatePlayback();
			},
			{ threshold: [0, 0.1] }
		).observe(newsTrack);
		mobile.addEventListener("change", updatePlayback);
		reducedMotion.addEventListener("change", updatePlayback);
		document.addEventListener("visibilitychange", updatePlayback);
		document.addEventListener("popupOpened", stop);
		document.addEventListener("popupClosed", updatePlayback);
	}
</script>
