---
import upper from "@assets/img/sponsor_upper.svg";
import lower from "@assets/img/sponsor_lower.svg";

const { t } = Astro.props;

// Each track repeats one image so the marquee loops seamlessly. The copies share
// one URL, so the browser downloads each image only once. Only the first copy is
// announced to screen readers.
const copies = [0, 1, 2];
---

<section id="sponsors">
	<div class="sponsors-container">
		<div class="marquee-container">
			<div class="marquee-track">
				{
					copies.map(i => (
						<img
							src={upper.src}
							width={upper.width}
							height={upper.height}
							alt={i === 0 ? t.logos_alt[0] : ""}
							aria-hidden={i === 0 ? undefined : "true"}
							class="sponsor-image"
							loading="lazy"
							decoding="async"
						/>
					))
				}
			</div>
		</div>
		<h2 class="aos aos-fadeIn">
			{t.inline.map((line: string) => <span>{line}</span>)}
		</h2>
		<div class="marquee-container">
			<div class="marquee-track lower-marquee">
				{
					copies.map(i => (
						<img
							src={lower.src}
							width={lower.width}
							height={lower.height}
							alt={i === 0 ? t.logos_alt[1] : ""}
							aria-hidden={i === 0 ? undefined : "true"}
							class="sponsor-image"
							loading="lazy"
							decoding="async"
						/>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	section {
		padding: 4rem 0;
		background-color: var(--white);
		overflow: hidden;
	}

	.sponsors-container {
		width: 100%;
		text-align: center;
		page-break-inside: avoid;
	}

	h2 {
		font-size: 2.5rem;
		margin: 3rem auto;
		padding: 1rem 2rem;
		max-width: 75rem;
	}

	h2 span {
		display: block;
	}

	.marquee-container {
		width: 100%;
		overflow: hidden;
		opacity: 0.3;
		margin: 2rem 0;
	}

	.marquee-track {
		display: flex;
		animation: marquee 30s linear infinite;
		width: max-content;
		margin: 0 auto;
	}

	.lower-marquee {
		animation-direction: reverse;
	}

	.sponsor-image {
		height: 240px;
		width: auto;
		display: block;
		flex-shrink: 0;
	}

	@keyframes marquee {
		0% {
			transform: translateX(0%);
		}
		100% {
			transform: translateX(-33.33%);
		}
	}

	@media screen and (max-width: 55rem) {
		h2 span {
			display: inline;
		}
		section {
			padding: 2rem 0;
		}

		.marquee-container {
			margin: 1.5rem 0;
		}

		.sponsor-image {
			height: 200px;
			margin-right: 2rem;
		}

		.marquee-track {
			animation-duration: 20s;
		}

		h2 {
			font-size: 1.8rem;
			margin: 2rem auto;
			padding: 0.5rem 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}
	}

	@media print {
		section {
			padding: 0;
			padding-top: 0px;
			margin-bottom: 20pt;
		}

		h2 {
			font-size: 18pt;
			margin: 0 auto;
		}

		.sponsor-image {
			height: 80pt;
		}

		.marquee-track {
			animation: none;
		}

		.marquee-container {
			opacity: 1;
			margin: 1rem 0;
		}
	}
</style>
