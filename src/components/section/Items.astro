---
import { X, Heart, Plus, Check, Circle, CircleDot } from "@lucide/astro";
import Button from "../Button.astro";
import { loadItemsData, translateType } from "../../utils/items-loader";
import { isInactive } from "../../utils/item-status";
import { purposes } from "../../utils/item-filters";
import "../../assets/item-filters.css";
import ItemCard from "@components/items/ItemCard.astro";

const { t, lang } = Astro.props;
const itemsUnsorted = await loadItemsData(lang); // Keep all items including "打包專屬"
// Sort items by order field for initial "all" category display
// Sold-out OR expired items (deadline passed) go to the bottom
const items = itemsUnsorted.sort((a, b) => {
	const aInactive = isInactive(a);
	const bInactive = isInactive(b);

	// Inactive (sold-out or expired) items go to bottom
	if (aInactive && !bInactive) return 1;
	if (!aInactive && bInactive) return -1;

	// Otherwise sort by order
	const orderA = a.order || 0;
	const orderB = b.order || 0;
	return orderA - orderB;
});
const formatOrder = ["現場實體曝光", "數位媒體曝光", "紀念品配件曝光", "獨家議程", "更多曝光方式"];
const formats = [...new Set(items.map(item => item.format))].sort((a, b) => {
	const rank = (format: string) => {
		const index = formatOrder.indexOf(format);
		return index === -1 ? formatOrder.length : index;
	};
	return rank(a) - rank(b);
});
const groups = [
	{ id: "purpose", label: t.filters.purpose, options: purposes.map(id => ({ id, label: t.item_categories[id] })) },
	{ id: "format", label: t.filters.format, options: formats.map(id => ({ id, label: translateType(id, lang).replaceAll("曝光", "") })) }
];
---

<section id="items">
	<div class="container">
		<h2>{t.title}</h2>

		<div class="filters">
			<p class="filter-question" style="text-align: center; font-size: 1.25rem; font-weight: 600;">{t.filters.question}</p>
			{
				groups.map(group => (
					<fieldset class="filter-row" aria-label={group.label}>
						{group.id === "format" && (
							<p class="filter-question" style="text-align: center; font-size: 1.25rem; font-weight: 600;">
								{t.filters.formatQuestion}
							</p>
						)}
						<div class="filter-options">
							{group.options.map(option => (
								<Button
									type="button"
									variant="normal"
									color="var(--white)"
									textColor="var(--black)"
									hoverColor="var(--filter-bg, var(--gray-container))"
									class="filter-toggle"
									data-filter-group={group.id}
									data-filter-value={option.id}
									data-filter-tone={group.id}
									aria-pressed="false"
									aria-controls="item-catalog"
								>
									{group.id === "purpose" ? (
										<span class="filter-radio-indicator" aria-hidden="true">
											<span class="filter-unselected-icon">
												<Circle size={16} />
											</span>
											<span class="filter-selected-icon">
												<CircleDot size={16} />
											</span>
										</span>
									) : (
										<span class="filter-multi-indicator" aria-hidden="true">
											<span class="filter-unselected-icon">
												<Plus size={16} />
											</span>
											<span class="filter-selected-icon">
												<Check size={16} />
											</span>
										</span>
									)}
									<span>{option.label}</span>
								</Button>
							))}
						</div>
					</fieldset>
				))
			}
		</div>
		<p class="filter-results" style="visibility: hidden;" role="status" aria-live="polite" data-filter-count data-template={t.filters.count}>
			{t.filters.count.replace("{count}", String(items.length))}
		</p>
		<div class="filter-empty" hidden>
			<p>{t.filters.empty}</p>
			<Button type="button" variant="normal" color="var(--white)" textColor="var(--black)" hoverColor="var(--gray-container)" size="compact" class="filter-toggle" data-clear-filters
				>{t.filters.clear}</Button
			>
		</div>

		<div class="cards-container fade-active" id="item-catalog">
			<div class="cards-grid">
				{items.map(card => <ItemCard t={t} card={card} lang={lang} />)}
			</div>
			<div class="fade-overlay"></div>
		</div>

		<button class="expand-button" id="expandButton" aria-expanded="false" aria-controls="item-catalog">
			<span class="show-text">{t.expandAll}</span>
			<span class="hide-text" style="display: none;">{t.showLess}</span>
			<span class="arrow">▼</span>
		</button>

		<Button
			variant="outlined"
			color="var(--white)"
			textColor="var(--black)"
			borderColor="var(--items-green)"
			size="icon"
			class="interest-button"
			id="interestButton"
			type="button"
			aria-label={t.interestedItems}
		>
			<span class="heart-icon"><Heart /></span>
			<span class="interest-count">0</span>
		</Button>

		<div class="interest-popover lenis-scroll" id="interestPopover">
			<div class="popover-header">
				<h3>{t.interestedItems}</h3>
			</div>
			<div class="popover-content">
				<div class="interest-items-list" id="interestItemsList"></div>
			</div>
			<div class="popover-footer">
				<p class="footer-text">{t.shareInterestedItemsText}</p>
				<div class="action-buttons">
					<Button size="compact" hoverColor="#404040" class="action-button download-quote-btn" type="button">
						{t.downloadQuote}
					</Button>
					<Button size="compact" hoverColor="#404040" class="action-button view-plan-btn" id="viewPlanBtn" type="button">
						<span id="viewPlanBtnText">{t.viewPlanDetails}</span>
					</Button>
				</div>
			</div>
		</div>

		<template id="removeIconTemplate">
			<X />
		</template>
		<div data-i18n-no-items style="display: none;">{t.noInterestedItems}</div>
		<div data-i18n-subtotal style="display: none;">{t.subtotal}</div>
	</div>
</section>

<style>
	section {
		background-color: var(--items-bg);
		padding: 4rem 0;
		min-height: 100svh;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.filters {
		margin: 0 0 1.5rem;
	}
	.filter-question {
		text-align: center;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--black);
		margin: 0 0 0.75rem;
	}
	.filter-row {
		border: 0;
		padding: 0;
		margin: 0 0 1rem;
		min-width: 0;
	}
	.filter-options {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.filter-results {
		font-size: 0.9rem;
		color: var(--black);
	}
	.filter-results {
		text-align: center;
		margin-bottom: 1rem;
	}
	.filter-empty {
		text-align: center;
		padding: 2rem 1rem;
	}

	.cards-container {
		position: relative;
		margin-bottom: 3rem;
		transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
		overflow: hidden;
	}

	.cards-container.is-collapsing {
		transition: none;
	}

	.cards-container.fade-active {
		max-height: 800px;
	}

	.cards-container.fade-hidden {
		max-height: 50000px;
	}

	.fade-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 150px;
		background: linear-gradient(transparent, var(--items-bg));
		pointer-events: none;
		transition: opacity 0.3s ease;
		z-index: 1;
	}

	.cards-container.fade-hidden .fade-overlay {
		opacity: 0;
		visibility: hidden;
	}

	.cards-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		justify-content: center;
		gap: 2rem;
	}

	.expand-button {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin: 0 auto;
		padding: 1rem 2rem;
		background: none;
		border: none;
		color: #007aff;
		font-size: 1rem;
		font-family: inherit;
		font-weight: 700;
		cursor: pointer;
		position: relative;
		z-index: 2;
	}

	.expand-button:hover {
		color: #0056cc;
	}

	.expand-button .arrow {
		transition: transform 0.3s ease;
		font-size: 0.8rem;
	}

	:global(.site-button.interest-button) {
		border-width: 2px;
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		width: 3.5rem;
		height: 3.5rem;
		display: none;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
		z-index: 1000;
	}

	:global(.interest-button .heart-icon) {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--black);
		transition: all 0.2s ease;
	}

	:global(.interest-button .heart-icon svg) {
		stroke-width: 2;
	}

	:global(.interest-button .interest-count) {
		position: absolute;
		top: -4px;
		right: -4px;
		background-color: var(--black);
		color: var(--white);
		font-size: 0.75rem;
		font-weight: 600;
		min-width: 18px;
		height: 18px;
		border-radius: 9px;
		display: flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
		opacity: 0;
		transform: scale(0.5);
		transition: all 0.2s ease;
	}

	:global(.interest-button .interest-count:not(:empty)) {
		opacity: 1;
		transform: scale(1);
	}

	.interest-popover {
		position: fixed;
		z-index: 1000;
		bottom: 6.5rem;
		right: 2rem;
		width: 20rem;
		max-width: calc(100vw - 4rem);
		max-height: 60rem;
		background-color: var(--white);
		border-radius: 1rem;
		box-shadow:
			0 0.5rem 2rem rgba(0, 0, 0, 0.12),
			0 0.25rem 1rem rgba(0, 0, 0, 0.08);
		visibility: hidden;
		opacity: 0;
		transform: scale(0.95) translateY(-4px);
		transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.interest-popover.active {
		visibility: visible;
		opacity: 1;
		transform: scale(1) translateY(0);
	}

	.popover-header {
		padding: 1rem;
		text-align: left;
		position: relative;
	}

	.popover-header h3 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 400;
		letter-spacing: -0.01em;
	}

	.popover-content {
		overflow-y: auto;
		max-height: 320px;
	}

	.popover-footer {
		padding: 1rem;
		border-top: 1px solid rgba(0, 0, 0, 0.04);
		background-color: rgba(0, 0, 0, 0.01);
	}

	.footer-text {
		margin: 0;
		font-size: 0.85rem;
		color: var(--gray);
		text-align: left;
		line-height: 1.4;
	}

	.interest-items-list {
		padding: 0rem 1rem;
	}

	:global(.empty-state) {
		text-align: center;
		color: var(--gray);
		font-size: 0.9rem;
		padding: 3rem 2rem;
	}

	:global(.interest-item) {
		border-bottom: 1px solid rgba(0, 0, 0, 0.04);
		transition: background-color 0.2s ease;
	}

	:global(.interest-item:last-child) {
		border-bottom: none;
	}

	:global(.item-content) {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		min-height: 28px;
	}

	:global(.item-title) {
		font-size: 0.95rem;
		color: var(--black);
		flex: 1;
		line-height: 1.4;
		font-weight: 500;
		text-align: left;
		padding-right: 1rem;
	}

	:global(.item-price-tag) {
		font-size: 0.85rem;
		color: var(--gray);
		font-weight: 500;
		white-space: nowrap;
	}

	:global(.interest-subtotal) {
		display: flex;
		justify-content: space-between;
		padding: 0.75rem 1rem;
		font-size: 0.9rem;
		font-weight: 700;
		border-top: 1px solid rgba(0, 0, 0, 0.08);
	}

	:global(.remove-item) {
		--site-button-background: transparent;
		--site-button-color: rgba(0, 0, 0, 0.4);
		--site-button-hover-background: rgba(0, 0, 0, 0.06);
		--site-button-hover-color: rgba(0, 0, 0, 0.8);
		flex-shrink: 0;
	}

	:global(.remove-item svg) {
		stroke-width: 2;
	}

	.action-buttons {
		display: flex;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	:global(.action-button) {
		flex: 1;
		font-weight: 400;
		text-align: center;
		white-space: nowrap;
	}

	@media screen and (max-width: 1024px) {
		.cards-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media screen and (max-width: 768px) {
		.cards-grid {
			grid-template-columns: minmax(0, 25rem);
		}

		.container {
			padding: 0 1rem;
		}

		:global(.site-button.interest-button) {
			bottom: 1rem;
			right: 1rem;
			width: 50px;
			height: 50px;
		}

		:global(.interest-button .interest-count) {
			font-size: 0.7rem;
			min-width: 16px;
			height: 16px;
			border-radius: 8px;
		}

		.interest-popover {
			width: calc(100vw - 32px);
			max-width: 300px;
			max-height: 60rem;
		}

		.popover-content {
			max-height: calc(60svh - 80px);
		}
	}

	@media print {
		section {
			display: none !important;
		}
	}
</style>
