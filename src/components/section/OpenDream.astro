---
import Cycle from "./Cycle.astro";
const { t, lang } = Astro.props;
import Popup from "@components/Popup.astro";
import { Check, Ticket, Globe, Newspaper, Megaphone, FileChartColumn } from "@lucide/astro";
import Button from "../Button.astro";
import ItemPrice from "../items/ItemPrice.astro";
import volunteer from "@assets/img/opendream-2026.webp";

interface OpenDreamPlan {
	id: string;
	name: string;
	price: string;
}

const benefitIcons = { ticket: Ticket, web: Globe, news: Newspaper, social: Megaphone, report: FileChartColumn };

interface PopupBenefit {
	icon: keyof typeof benefitIcons;
	title: string;
	description: string;
}

const colors = ["#77B55A", "#537FF1"];
const cycleText = (await import(`../../i18n/${lang}.json`)).default.cycle;
---

<section id="opendream">
	<h2><span>{t.subtitle}</span>{t.title}</h2>
	<div class="container">
		<p class="description">{t.description}</p>
		<div class="plans">
			{
				t.plans.map((plan: OpenDreamPlan, index: number) => (
					<div class="tier-column">
						<div class="tier-name" style={`color: ${colors[index % colors.length]}`}>
							{plan.name}
						</div>
						<ItemPrice price={plan.price} />
						<Button
							variant="outlined"
							size="default"
							class="tier-interest-button"
							data-tier-name={plan.id}
							data-tier-title={`${t.title}｜${plan.name}`}
							data-tier-price={plan.price}
							data-default-label={t.interested}
							data-selected-label={t.popup.cta.selected}
							aria-pressed="false"
						>
							{t.interested}
						</Button>
					</div>
				))
			}
		</div>
		<h3>{t.benefits_title}</h3>
		<ul class="benefits">
			{
				t.benefits.map((benefit: string) => (
					<li>
						<Check size={20} />
						{benefit}
					</li>
				))
			}
		</ul>
		<p class="note">{t.exclusive_note}</p>
		<p class="note">{t.price_note}</p>
	</div>
	<div class="aos spacer"></div>
	<Popup btnText={t.popup_label} title={t.popup.title} id="opendream-popup" background={volunteer.src} lang={lang}>
		<div class="popup-body" lang={lang}>
			<section class:list={["dream-section purpose-section", { "purpose-section-en": lang === "en" }]} aria-labelledby="dream-purpose-title">
				<h3 id="dream-purpose-title">{t.popup.hero.headline}</h3>
				<p>{t.popup.hero.description}</p>
			</section>

			<section class="dream-section impact-section" aria-labelledby="dream-impact-title">
				<h3 id="dream-impact-title">{t.popup.impact.title}</h3>
				<div class="impact-grid">
					{
						t.plans.map((plan: OpenDreamPlan, index: number) => (
							<div class="impact-plan" style={`--impact-color: ${colors[index % colors.length]}`}>
								<h4 aria-label={plan.name}>
									{plan.name.split(/(\d+)/).map(part => (
										<span class:list={{ "impact-count": /^\d+$/.test(part) }} aria-hidden="true">
											{part.trim()}
										</span>
									))}
								</h4>
								<ItemPrice price={plan.price} />
								<Button
									variant="outlined"
									size="default"
									class="tier-interest-button"
									data-tier-name={plan.id}
									data-tier-title={`${t.title}｜${plan.name}`}
									data-tier-price={plan.price}
									data-default-label={t.interested}
									data-selected-label={t.popup.cta.selected}
									aria-pressed="false"
								>
									{t.interested}
								</Button>
							</div>
						))
					}
				</div>
				<p class="section-note">{t.popup.impact.note}</p>
			</section>

			<section class="dream-section" aria-labelledby="dream-plan-title">
				<h3 id="dream-plan-title">{t.popup.plan_value.title}</h3>
				<p>{t.popup.plan_value.value_statement}</p>
				<div class="fund-layout">
					<div class="fund-highlight">
						<ItemPrice price={t.popup.plan_value.direct_value} />
						<span>{t.popup.plan_value.direct_label}</span>
					</div>
					<div>
						<ul class="support-details">
							{t.popup.plan_value.support_items.map((item: string) => <li>{item}</li>)}
						</ul>
						<p class="section-note">{t.popup.plan_value.note}</p>
					</div>
				</div>
			</section>

			<section class="dream-section" aria-labelledby="dream-benefits-title">
				<h3 id="dream-benefits-title">{t.popup.sponsor_benefits.title}</h3>
				<p>{t.popup.sponsor_benefits.description}</p>
				<dl class="benefit-grid">
					{
						t.popup.sponsor_benefits.items.map((benefit: PopupBenefit) => {
							const Icon = benefitIcons[benefit.icon];
							return (
								<div class="benefit-card">
									<dt>
										<Icon size={28} stroke-width={1.7} aria-hidden="true" />
										{benefit.title}
									</dt>
									<dd>{benefit.description}</dd>
								</div>
							);
						})
					}
				</dl>
			</section>

			<section class="dream-section details-section" aria-labelledby="dream-eligibility-title">
				<h3 id="dream-eligibility-title">{t.popup.eligibility.title}</h3>
				<p>{t.popup.eligibility.description}</p>
				<ol class="review-steps">{t.popup.eligibility.steps.map((step: string) => <li>{step}</li>)}</ol>
				<p class="section-note">{t.popup.eligibility.note}</p>
			</section>

			<section class="dream-section" aria-labelledby="dream-comparison-title">
				<h3 id="dream-comparison-title">{t.popup.comparison.title}</h3>
				<div class="comparison-grid">
					{
						t.popup.comparison.items.map((item: { title: string; points: string[] }) => (
							<div>
								<h4>{item.title}</h4>
								<ul>
									{item.points.map(point => (
										<li>{point}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<section class="dream-section" aria-labelledby="dream-links-title">
				<h3 id="dream-links-title">{t.popup.links_title}</h3>
				<p class="section-note">{t.popup.links_description}</p>
				<ul class="popup-links">
					{
						t.popup.links.map((link: { name: string; url: string }) => (
							<li>
								<a href={link.url} target="_blank" rel="noopener noreferrer">
									{link.name} ↗
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</div>
	</Popup>
	<details class="impact-details"><summary>{lang === "en" ? "How your support makes an impact" : "了解贊助如何支持資訊教育"}</summary><Cycle t={cycleText} lang={lang} /></details>
</section>

<script>
	import { isItemInterested, addInterestedItem, removeInterestedItem, getInterestedItems } from "../../utils/local-storage.ts";

	const PREFIX = "opendream-";

	function updateButtonStates() {
		document.querySelectorAll<HTMLButtonElement>("#opendream .tier-interest-button").forEach(button => {
			const id = button.getAttribute("data-tier-name") || "";
			const selected = isItemInterested(id);
			button.classList.toggle("interested", selected);
			button.setAttribute("aria-pressed", String(selected));
			if (button.dataset.defaultLabel && button.dataset.selectedLabel) button.textContent = selected ? button.dataset.selectedLabel : button.dataset.defaultLabel;
		});
	}

	document.addEventListener("DOMContentLoaded", () => {
		document.querySelectorAll<HTMLButtonElement>("#opendream .tier-interest-button").forEach(button => {
			button.addEventListener("click", e => {
				e.stopPropagation();
				const id = button.getAttribute("data-tier-name") || "";
				const title = button.getAttribute("data-tier-title") || "";
				const price = button.getAttribute("data-tier-price") || "";

				if (isItemInterested(id)) {
					removeInterestedItem(id);
				} else {
					// Only one Open Dream option at a time
					getInterestedItems()
						.filter(item => item.id.startsWith(PREFIX))
						.forEach(item => removeInterestedItem(item.id));
					addInterestedItem({ id, title, category: "opendream", image: "", deadline: "", price });
				}
			});
		});
		updateButtonStates();
	});

	window.addEventListener("itemsChange", updateButtonStates);
	document.addEventListener("interested-items-changed", updateButtonStates);
</script>

<style>
	section#opendream {
		background-color: var(--items-bg);
		padding: 5rem 2rem;
		display: flex;
		flex-direction: column;
	}

	h2 span {
		display: block;
		font-size: 1.25rem;
		color: var(--gray);
		margin-bottom: 0.5rem;
	}

	.container {
		max-width: min(1200px, 100%);
		width: 100%;
		border-radius: 2rem;
		background-color: var(--white);
		margin: 0 auto;
		padding: 3rem;
	}

	.description {
		max-width: 50rem;
		margin: 0 auto 3rem;
		text-align: center;
		font-size: 1.15rem;
		line-height: 1.8;
	}

	.plans {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
		max-width: 40rem;
		margin: 0 auto 3rem;
	}

	.tier-column {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 1.5rem;
		border-radius: 1rem;
		background-color: var(--container);
	}

	.tier-name {
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.2;
		overflow-wrap: anywhere;
	}

	.tier-column :global(.sponsorship-price),
	.impact-plan :global(.sponsorship-price) {
		color: var(--black);
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.3;
	}

	h3 {
		text-align: center;
		font-size: 1.5rem;
		margin-bottom: 1rem;
	}

	.benefits {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 2rem;
		margin-bottom: 2rem;
	}

	.benefits li {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 1.1rem;
	}

	.benefits svg {
		color: var(--items-green);
	}

	.note {
		text-align: center;
		color: var(--gray);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.spacer {
		height: 2rem;
	}

	.popup-body {
		padding: 0 3rem;
		color: var(--black);
		container-type: inline-size;
	}

	.dream-section {
		padding: 1.5rem 0;
	}

	.details-section {
		border-top: 1px solid var(--gray-container);
		margin-top: 1rem;
	}

	.dream-section.purpose-section {
		padding-top: 3.5rem;
	}

	.purpose-section p {
		max-width: none;
		font-size: 1.125rem;
	}

	.dream-section h3 {
		text-align: left;
		font-size: 1.8rem;
		line-height: 1.3;
		margin: 0 0 1rem;
	}

	.purpose-section h3 {
		max-width: none;
		font-size: clamp(1.875rem, 3.5vw, 2.75rem);
		letter-spacing: -0.025em;
	}

	.purpose-section-en h3,
	.purpose-section-en p {
		max-width: none;
	}

	.dream-section h4,
	.benefit-grid dt {
		font-size: 1.1rem;
		font-weight: 700;
		margin: 0 0 0.5rem;
	}

	.dream-section p,
	.dream-section li,
	.benefit-grid dd {
		line-height: 1.6;
	}

	.dream-section p {
		margin: 0 0 1rem;
	}

	.dream-section .section-note {
		font-size: 0.95rem;
		color: var(--gray);
		margin: 1rem 0 0;
	}

	.impact-grid,
	.comparison-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
	}

	.impact-grid {
		background: var(--white);
		border-radius: 1.5rem;
		padding: 2rem 0;
		gap: 0;
	}

	.impact-plan {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding-inline: 1rem;
	}

	.impact-plan + .impact-plan {
		border-left: 1px solid var(--gray-container);
	}

	.impact-plan h4 {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		color: var(--impact-color);
		font-size: 1.1rem;
		line-height: 1.4;
		margin-bottom: 1rem;
	}

	.impact-count {
		font-size: clamp(4rem, 10vw, 7rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.05em;
	}

	/* Keep each tier on one centered axis, with its student count in a single row. */
	@container (min-width: 38rem) {
		.impact-plan h4 {
			flex-direction: row;
			align-items: baseline;
			justify-content: center;
			gap: 0.5rem;
			font-size: clamp(1.25rem, 2.2cqw, 1.5rem);
		}

		.impact-count {
			font-size: clamp(3.5rem, 8cqw, 5.5rem);
		}
	}

	.impact-plan :global(.tier-interest-button) {
		margin-top: 1rem;
	}

	.benefit-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 1.5rem 0 0;
	}

	.benefit-card:last-child {
		grid-column: 1 / -1;
	}

	/* Card radius and spacing follow Highlights; icons sit beside the copy. */
	.benefit-card {
		position: relative;
		background: var(--white);
		border-radius: 1rem;
		padding: 1.5rem 1.5rem 1.5rem 4.25rem;
	}

	.benefit-card dt {
		line-height: 1.4;
	}

	.benefit-card svg {
		position: absolute;
		left: 1.5rem;
		top: 1.5rem;
		color: var(--gray);
	}

	.benefit-grid dd {
		margin: 0;
		font-size: 0.95rem;
	}

	.fund-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
		gap: 2rem;
		align-items: center;
		margin-top: 1rem;
		padding: 1.5rem;
		border-radius: 1rem;
		background: var(--white);
	}

	.fund-highlight {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		line-height: 1.6;
	}

	.fund-highlight :global(.sponsorship-price) {
		font-size: clamp(1.4rem, 3vw, 2rem);
	}

	.fund-layout .support-details {
		margin-top: 0;
	}

	.support-details,
	.review-steps,
	.comparison-grid ul {
		padding-left: 1.25rem;
		margin: 1rem 0 0;
	}

	.dream-section li + li {
		margin-top: 0.5rem;
	}

	.popup-links {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
	}

	.popup-links a {
		color: #0171e3;
		text-decoration: underline;
		text-underline-offset: 3px;
		overflow-wrap: anywhere;
	}

	.popup-links a:focus-visible {
		outline: 2px solid #14693e;
		outline-offset: 3px;
	}

	@container (max-width: 20rem) {
		.benefit-card,
		.fund-layout {
			padding: 1rem;
		}

		.benefit-card dt {
			display: flex;
			align-items: center;
			gap: 0.75rem;
		}

		.benefit-card svg {
			position: static;
			flex-shrink: 0;
		}

		.fund-highlight :global(.sponsorship-price) {
			font-size: 1.125rem;
		}
	}

	.dream-section > p:last-child:not(.section-note) {
		margin-bottom: 0;
	}

	@media screen and (max-width: 65rem) {
		.benefit-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media screen and (max-width: 45rem) {
		.container {
			padding: 2rem 1.5rem;
		}

		.plans,
		.fund-layout,
		.benefit-grid,
		.comparison-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.popup-body {
			padding-inline: 1.5rem;
		}

		.dream-section.purpose-section {
			padding-top: 2.5rem;
		}

		.impact-grid {
			padding-block: 1.75rem;
		}

		.impact-plan {
			padding-inline: 0.5rem;
		}

		.impact-plan :global(.tier-interest-button) {
			padding-inline: 0.75rem;
		}

		.dream-section h3 {
			font-size: 1.5rem;
		}

		.purpose-section h3 {
			font-size: 1.875rem;
		}
	}

	@media screen and (max-width: 30rem) {
		.impact-grid {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.impact-plan + .impact-plan {
			border-left: 0;
			border-top: 1px solid var(--gray-container);
			padding-top: 1.75rem;
		}
	}

	@media print {
		section#opendream {
			padding: 2rem;
			break-inside: avoid;
		}

		:global(.tier-interest-button) {
			display: none;
		}
	}
	.impact-details {
		max-width: 70rem;
		margin: 2rem auto;
	}
	summary {
		cursor: pointer;
		padding: 1rem;
		text-align: center;
	}
</style>
