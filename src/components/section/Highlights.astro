---
const { t } = Astro.props;
import { ArrowRight } from "@lucide/astro";

interface HighlightCard {
	badge?: string;
	category?: string;
	title: string;
	description: string;
	link: string;
	cta: string;
}
---

<section id="highlights">
	<h2>{t.title}</h2>
	{t.subtitle && <p class="subtitle">{t.subtitle}</p>}
	<div class="cards">
		{
			t.cards.map((card: HighlightCard) => (
				<a class="card aos aos-fadeInBottom" href={card.link} data-item-category={card.category}>
					<div class="title-row">
						<h3>{card.title}</h3>
						{card.badge && <span class="badge">{card.badge}</span>}
					</div>
					<p>{card.description}</p>
					<span class="cta">
						{card.cta}
						<ArrowRight size={18} />
					</span>
				</a>
			))
		}
	</div>
</section>

<style>
	section {
		padding: 5rem 2rem;
		background-color: var(--white);
	}

	h2 {
		margin-bottom: 0.75rem;
	}

	.subtitle {
		text-align: center;
		color: var(--black);
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 3rem;
	}

	.cards {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2rem;
		border-radius: 1rem;
		background-color: var(--container);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
	}

	.title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.badge {
		white-space: nowrap;
		background-color: var(--items-green);
		color: var(--black);
		border-radius: 20px;
		padding: 0.1rem 0.7rem;
		font-size: 0.85rem;
		font-weight: 500;
	}

	h3 {
		font-size: 1.6rem;
	}

	p {
		line-height: 1.6;
		flex: 1;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: #0171e3;
		font-weight: 600;
	}

	@media screen and (max-width: 60rem) {
		.cards {
			grid-template-columns: 1fr;
			max-width: 32rem;
		}
	}

	@media screen and (min-width: 60rem) and (max-width: 1100px) {
		.cards {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media print {
		section {
			padding: 1rem 0;
		}

		.card {
			break-inside: avoid;
		}

		.cta {
			display: none;
		}
	}
</style>
