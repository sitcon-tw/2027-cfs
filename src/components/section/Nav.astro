---
const { t, lang } = Astro.props;
import Button from "../Button.astro";
---

<nav aria-label="Main Navigation" class="navbar">
	<div class="nav-container">
		<a href="#"><h1 class="nav-title">{t.title}</h1></a>
		<Button class="hamburger" size="icon" color="transparent" hoverColor="transparent" textColor="var(--black)" aria-label="Toggle menu" aria-expanded="false">
			<span class="hamburger-line"></span>
			<span class="hamburger-line"></span>
			<span class="hamburger-line"></span>
		</Button>
		<div class="nav-menu" id="nav-menu">
			<a href="#about" class="nav-link">{t.data}</a>
			<a href="#time" class="nav-link">{t.info}</a>
			<a href="#plans" class="nav-link">{t.plan}</a>
			<a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/` + (t.langChange == "中文" ? "" : "en/")} class="nav-link lang-switch">{t.langChange}</a>
			<Button href="mailto:contact@sitcon.org" size="compact" color="#74bf50" hoverColor="color-mix(in srgb, #74bf50 85%, black)" textColor="var(--black)" class="nav-link contact-btn"
				>{t.contact}</Button
			>
			<Button
				color="#e8e8ed"
				hoverColor="#d0d0d5"
				textColor="var(--black)"
				hoverTextColor="#000"
				href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/${lang === "en" ? "en/" : ""}brochure/`}
				size="compact"
				class="nav-link export-btn"
				target="_blank"
				rel="noopener">{t.export}</Button
			>
		</div>
	</div>
</nav>

<style>
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		background: rgba(250, 250, 252, 0.8);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}

	.nav-container {
		padding: 1rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin: auto;
		max-width: 1200px;
	}

	.nav-title {
		font-size: 1.3rem;
		font-weight: bold;
		white-space: nowrap;
	}

	.nav-menu {
		display: flex;
		align-items: center;
		gap: 1rem;
		white-space: nowrap;
	}

	a:not(.site-button) {
		text-decoration: none;
		color: inherit;
		transition: 0.2s ease-out;
	}

	:global(.nav-link:not(.site-button):hover) {
		color: #6b6b73;
	}

	/* Hamburger Menu */
	:global(.site-button.hamburger) {
		--hamburger-line-height: 0.15rem;
		--hamburger-line-gap: 0.3rem;
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: var(--hamburger-line-gap);
		z-index: 1001;
	}

	.hamburger-line {
		flex: none;
		width: 1.5rem;
		height: var(--hamburger-line-height);
		background-color: #000000;
		transition:
			transform 0.3s ease,
			opacity 0.3s ease;
		transform-origin: center;
	}

	/* Move the outer lines onto the middle line before rotating so they cross at the center. */
	:global(.hamburger.active .hamburger-line:nth-child(1)) {
		transform: translateY(calc(var(--hamburger-line-height) + var(--hamburger-line-gap))) rotate(45deg);
	}

	:global(.hamburger.active .hamburger-line:nth-child(2)) {
		opacity: 0;
	}

	:global(.hamburger.active .hamburger-line:nth-child(3)) {
		transform: translateY(calc(-1 * (var(--hamburger-line-height) + var(--hamburger-line-gap)))) rotate(-45deg);
	}

	@media screen and (max-width: 72rem) {
		:global(.site-button.hamburger) {
			display: flex;
		}

		.nav-menu {
			position: fixed;
			top: 4rem;
			left: 0;
			right: 0;
			flex-direction: column;
			padding: 3rem 1rem 1rem;
			gap: 2rem;
			opacity: 0;
			background: rgba(250, 250, 252, 0.95);
			backdrop-filter: blur(10px);
			-webkit-backdrop-filter: blur(10px);
			border-top: 1px solid rgba(232, 232, 237, 0.6);
			transition: opacity 0.3s ease;
			height: calc(100dvh - 4rem);
			pointer-events: none;
		}

		.nav-menu.active {
			opacity: 1;
			pointer-events: auto;
		}

		.nav-menu :global(.nav-link) {
			text-align: center;
		}
	}

	@media screen and (max-width: 30rem) {
		.nav-menu {
			padding: 2rem 1rem 1rem;
		}
		.nav-container {
			gap: 0.75rem;
			padding: 1rem 1.25rem;
		}
		.nav-container > a {
			min-width: 0;
			flex: 1 1 auto;
		}
		.nav-title {
			font-size: clamp(0.85rem, 4vw, 1.1rem);
			overflow: hidden;
			text-overflow: ellipsis;
		}
		:global(.site-button.hamburger) {
			flex-shrink: 0;
		}
		:global(.hamburger) {
			scale: 0.95;
		}
	}

	@media print {
		nav {
			display: none;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]').forEach(anchor => {
		anchor.addEventListener("click", event => {
			if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			const href = anchor.getAttribute("href")!;
			const target = href === "#" ? 0 : document.getElementById(href.slice(1));
			if (target === null) return;
			event.preventDefault();
			const oldURL = window.location.href;
			const destinationURL = new URL(href, oldURL).href;
			if (destinationURL !== oldURL) {
				history.pushState(null, "", destinationURL);
				window.dispatchEvent(new HashChangeEvent("hashchange", { oldURL, newURL: destinationURL }));
			}
			window.scrollPageTo(target, { immediate: false, offset: target === 0 ? 0 : -32 });
			if (target instanceof HTMLElement) {
				const hadTabindex = target.hasAttribute("tabindex");
				if (!hadTabindex) target.setAttribute("tabindex", "-1");
				target.focus({ preventScroll: true });
				if (!hadTabindex) target.addEventListener("blur", () => target.removeAttribute("tabindex"), { once: true });
			}
		});
	});

	const hamburger = document.querySelector(".hamburger") as HTMLButtonElement;
	const navMenu = document.querySelector(".nav-menu") as HTMLDivElement;
	hamburger.addEventListener("click", () => {
		const isExpanded = hamburger.getAttribute("aria-expanded") === "true";
		hamburger.setAttribute("aria-expanded", String(!isExpanded));
		hamburger.classList.toggle("active");
		navMenu.classList.toggle("active");
	});

	navMenu.querySelectorAll("a").forEach(link =>
		link.addEventListener("click", () => {
			hamburger.setAttribute("aria-expanded", "false");
			hamburger.classList.remove("active");
			navMenu.classList.remove("active");
		})
	);
</script>
