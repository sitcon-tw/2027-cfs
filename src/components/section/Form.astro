---
const { t, lang } = Astro.props;
const en = lang === "en";
---

<section id="form" data-contact-lang={lang}>
	<h2>{en ? "Let’s build SITCON 2027 together" : "一起成就 SITCON 2027"}</h2>
	<div class="email-draft">
		<p class="recipient">{en ? "To" : "收件人"} <span>contact@sitcon.org</span></p>
		<label for="inquiry-subject">{en ? "Subject" : "主旨"}</label>
		<input id="inquiry-subject" type="text" value={en ? "SITCON 2027 Sponsorship inquiry" : "SITCON 2027 贊助洽詢"} />
		<label for="inquiry-text">{en ? "Message" : "內文"}</label>
		<textarea id="inquiry-text" rows="11"></textarea>
		<div class="email-actions">
			<a class="email-action" data-sponsor-email href="mailto:contact@sitcon.org">{en ? "Open email app" : "開啟郵件程式"}</a>
			<a class="email-action gmail" data-sponsor-gmail href="https://mail.google.com/mail/?view=cm&fs=1&to=contact%40sitcon.org" target="_blank" rel="noopener noreferrer">
				{en ? "Open Gmail" : "開啟 Gmail"}
			</a>
		</div>
	</div>
	<p class="personal">{t.personal.title} <a href="https://sitcon.org/donate" target="_blank" rel="noopener">{t.personal.cta} →</a></p>
</section>
<script>
	import { getInterestedItems } from "../../utils/local-storage.ts";

	const subject = document.querySelector<HTMLInputElement>("#inquiry-subject");
	const draft = document.querySelector<HTMLTextAreaElement>("#inquiry-text");
	const email = document.querySelector<HTMLAnchorElement>("[data-sponsor-email]");
	const gmail = document.querySelector<HTMLAnchorElement>("[data-sponsor-gmail]");
	const en = document.documentElement.lang === "en";
	let previousSelection = "";

	function updateLinks() {
		if (!subject || !draft) return;
		if (email) email.href = `mailto:contact@sitcon.org?subject=${encodeURIComponent(subject.value)}&body=${encodeURIComponent(draft.value)}`;
		if (gmail) gmail.href = `https://mail.google.com/mail/?${new URLSearchParams({ view: "cm", fs: "1", to: "contact@sitcon.org", su: subject.value, body: draft.value })}`;
	}

	function updateSelection() {
		if (!draft) return;
		const items = getInterestedItems()
			.map(item => `• ${item.title}${item.price ? ` — ${item.price}` : ""}`)
			.join("\n");
		const selection = `\n\n${en ? "Plans / items of interest:" : "感興趣的方案／品項："}\n${items || (en ? "(Not selected)" : "（尚未選擇）")}\n\n`;
		if (!previousSelection) {
			draft.value = en
				? `Hello SITCON,\n\nWe are interested in sponsoring SITCON 2027.${selection}Organization:\nContact person:\nQuestions or goals:\n`
				: `SITCON 團隊好：\n\n我們有意贊助 SITCON 2027。${selection}單位名稱：\n聯絡人：\n合作想法／問題：\n`;
		} else {
			// Only refresh the generated selection block; preserve edits to the message.
			// If the selection block itself was edited, keep the author's version too.
			draft.value = draft.value.replace(previousSelection, () => selection);
		}
		previousSelection = selection;
		updateLinks();
	}
	updateSelection();
	window.addEventListener("itemsChange", updateSelection);
	subject?.addEventListener("input", updateLinks);
	draft?.addEventListener("input", updateLinks);
	email?.addEventListener("click", updateLinks);
	gmail?.addEventListener("click", updateLinks);
</script>
<style>
	section {
		padding: 4rem 1.5rem;
		text-align: center;
		background: #eff6ee;
	}
	h2 {
		font-size: clamp(1.8rem, 5vw, 3rem);
		margin-bottom: 2rem;
	}
	a {
		color: #12663c;
		text-underline-offset: 0.2em;
	}
	.email-draft {
		max-width: 42rem;
		margin: 0 auto 1.5rem;
		text-align: left;
	}
	.recipient {
		margin-bottom: 1.25rem;
		font-size: 0.95rem;
	}
	.recipient span {
		margin-left: 0.5rem;
	}
	label {
		display: block;
		margin-bottom: 0.4rem;
		font-size: 0.95rem;
		font-weight: 600;
	}
	input,
	textarea {
		box-sizing: border-box;
		width: 100%;
		padding: 0.75rem;
		margin-bottom: 1.25rem;
		font: inherit;
		font-size: 1rem;
		line-height: 1.6;
		color: #1d1d1f;
		background: white;
		border: 1px solid #8ba693;
		border-radius: 0.5rem;
	}
	textarea {
		resize: vertical;
		min-height: 12rem;
	}
	input:focus-visible,
	textarea:focus-visible,
	.email-action:focus-visible {
		outline: 2px solid #14693e;
		outline-offset: 3px;
	}
	.email-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.email-action {
		flex: 1;
		padding: 0.8rem 1rem;
		border: 1px solid #14693e;
		border-radius: 2rem;
		background: #14693e;
		color: white;
		text-decoration: none;
		text-align: center;
	}
	.gmail {
		background: white;
		color: #12663c;
	}
	.personal {
		font-size: 0.9rem;
		line-height: 1.7;
		margin: 0 auto;
	}
</style>
