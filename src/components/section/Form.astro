---
import Button from "../Button.astro";
import { contactForm } from "../../data/contact-form.ts";
const { t, lang } = Astro.props;
const en = lang === "en";
---

<section id="form" data-contact-lang={lang}>
	<h2>{en ? "Let's build SITCON 2027 together" : "一起成就 SITCON 2027"}</h2>
	<p class="intro">{en ? "Leave a way to reach you and we'll discuss a suitable partnership together." : "留下方便聯絡您的方式，我們會與您一起討論適合的合作方式。"}</p>
	<form id="sponsor-form" data-error={t.messages.error}>
		<div class="identity">
			<div><label for="organization">{t.fields.organization.title} <span aria-hidden="true">*</span></label><input id="organization" name="organization" autocomplete="organization" required /></div>
			<div><label for="contact-name">{t.fields.name.title} <span aria-hidden="true">*</span></label><input id="contact-name" name="name" autocomplete="name" required /></div>
		</div>
		<label for="contact">{t.fields.contact.title} <span aria-hidden="true">*</span></label>
		<p id="contact-help" class="help">{t.fields.contact.description}</p>
		<input id="contact" name="contact" type="text" aria-describedby="contact-help" placeholder={t.fields.contact.placeholder} required />
		<label for="inquiry-text">{en ? "Ideas or questions (optional)" : "合作想法或問題（選填）"}</label>
		<textarea
			id="inquiry-text"
			name="message"
			rows="4"
			placeholder={en ? "For example: recruiting, brand exposure, budget, or a good time to call." : "例如：徵才、品牌曝光、預算，或方便聯絡的時段。"}
		>
		</textarea>
		<div class="selection"><p>{en ? "Plans / items of interest" : "感興趣的方案／品項"}</p><p id="inquiry-selection"></p></div>
		<div class="submit-wrap">
			<Button id="submit" type="submit" size="default" color="#74bf50" hoverColor="color-mix(in srgb, #74bf50 85%, black)" textColor="var(--black, #1d1d1f)"
				>{en ? "Let's talk" : "送出合作洽詢"}</Button
			>
		</div>
		<p id="form-message" role="status" aria-live="polite"></p>
	</form>
	<p class="alternative">{en ? "You can also email us at" : "也歡迎直接來信"} <a href={`mailto:${contactForm.email}`}>{contactForm.email}</a></p>
	<p class="personal">{t.personal.title} <a href="https://sitcon.org/donate" target="_blank" rel="noopener">{t.personal.cta} →</a></p>
</section>
<script>
	import { getInterestedItems } from "../../utils/local-storage.ts";
	import { localizeInterestedItem } from "../../utils/plan-helper.ts";
	import { contactForm } from "../../data/contact-form.ts";

	const form = document.querySelector<HTMLFormElement>("#sponsor-form");
	const button = document.querySelector<HTMLButtonElement>("#submit");
	const status = document.querySelector<HTMLElement>("#form-message");
	const selection = document.querySelector<HTMLElement>("#inquiry-selection");
	const en = document.documentElement.lang === "en";
	const selectionText = () =>
		getInterestedItems()
			.map(item => localizeInterestedItem(item, document.documentElement.lang))
			.map(item => `• ${item.title}${item.price ? ` — ${item.price}` : ""}`)
			.join("\n");
	function updateSelection() {
		if (selection) selection.textContent = selectionText() || (en ? "Not selected yet — we can discuss this together." : "尚未選擇也沒關係，可以一起討論。");
	}
	updateSelection();
	window.addEventListener("itemsChange", updateSelection);

	/** mailto link to contactForm.email, optionally prefilled with the form answers. */
	function mailLink(text: string, fields?: Record<string, string>) {
		const link = document.createElement("a");
		link.textContent = text;
		link.href = `mailto:${contactForm.email}`;
		if (fields) {
			const subject = en ? `SITCON 2027 sponsorship inquiry: ${fields.organization}` : `SITCON 2027 贊助洽詢：${fields.organization}`;
			const lines = en
				? [`Organization: ${fields.organization}`, `Name: ${fields.name}`, `Contact: ${fields.contact}`, "", fields.message]
				: [`單位名稱：${fields.organization}`, `如何稱呼您：${fields.name}`, `聯絡方式：${fields.contact}`, "", fields.message];
			link.href += `?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n").trim())}`;
		}
		return link;
	}
	function showStatus(...parts: (string | Node)[]) {
		status?.replaceChildren(...parts);
	}
	form?.addEventListener("submit", async event => {
		event.preventDefault();
		if (!button || !status || button.disabled) return;
		const values = new FormData(form);
		for (const name of ["organization", "name", "contact"]) {
			if (!String(values.get(name) || "").trim()) {
				status.textContent = en ? "Please fill in the required fields." : "請填寫必填欄位。";
				form.querySelector<HTMLInputElement>(`[name="${name}"]`)?.focus();
				return;
			}
		}
		const items = selectionText();
		const fields = {
			organization: String(values.get("organization") || "").trim(),
			name: String(values.get("name") || "").trim(),
			contact: String(values.get("contact") || "").trim(),
			message: [String(values.get("message") || "").trim(), items ? `${en ? "Plans / items of interest:" : "感興趣的方案／品項："}\n${items}` : ""].filter(Boolean).join("\n\n")
		};
		const body = new FormData();
		for (const name of Object.keys(contactForm.entries) as (keyof typeof contactForm.entries)[]) body.set(contactForm.entries[name], fields[name]);
		const label = button.textContent;
		button.disabled = true;
		button.textContent = en ? "Sending…" : "送出中…";
		status.textContent = "";
		try {
			if (!navigator.onLine) throw new Error("offline");
			await fetch(contactForm.endpoint, { method: "POST", mode: "no-cors", body, signal: AbortSignal.timeout(20000) });
			// Google Forms returns an opaque response, so we only know the request left
			// the browser. Keep the entered data and tell people how to follow up.
			showStatus(en ? "Inquiry sent. Thank you! If you don't hear from us, please email " : "已送出洽詢，謝謝您！若之後沒有收到我們的聯繫，請來信 ", mailLink(contactForm.email), en ? "." : "。");
		} catch {
			showStatus(
				`${form.dataset.error || "Please try again."}${en ? " You can also " : "，或"}`,
				mailLink(en ? "send it by email instead" : "改用 Email 寄送（內容會自動帶入）", fields),
				en ? " (your answers are filled in)." : "。"
			);
		} finally {
			button.disabled = false;
			button.textContent = label;
		}
	});
</script>
<style>
	section {
		padding: 4rem 1.5rem;
		text-align: center;
		background: #eff6ee;
	}
	h2 {
		font-size: clamp(1.8rem, 5vw, 3rem);
		margin-bottom: 1rem;
	}
	.intro {
		margin: 0 auto 2rem;
		max-width: 42rem;
		line-height: 1.7;
	}
	form {
		max-width: 42rem;
		margin: 0 auto 1.5rem;
		text-align: left;
	}
	.identity {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.identity > div {
		min-width: 0;
	}
	label {
		display: block;
		margin-bottom: 0.4rem;
		font-weight: 600;
	}
	label span {
		color: #a12b23;
	}
	.help {
		font-size: 0.9rem;
		line-height: 1.6;
		margin-bottom: 0.5rem;
	}
	input,
	textarea {
		box-sizing: border-box;
		width: 100%;
		padding: 0.75rem;
		margin-bottom: 1.25rem;
		font: inherit;
		font-size: 1rem;
		line-height: 1.6;
		color: #1d1d1f;
		background: white;
		border: 1px solid #8ba693;
		border-radius: 0.5rem;
	}
	textarea {
		resize: vertical;
		min-height: 7rem;
	}
	.selection {
		background: #fff9;
		padding: 1rem;
		border-radius: 0.5rem;
		margin-bottom: 1.25rem;
		font-size: 0.95rem;
		line-height: 1.6;
	}
	#inquiry-selection {
		white-space: pre-line;
		overflow-wrap: anywhere;
		margin-top: 0.4rem;
	}
	.submit-wrap {
		display: flex;
		justify-content: center;
	}
	input:focus-visible,
	textarea:focus-visible {
		outline: 2px solid #74bf50;
		outline-offset: 3px;
	}
	#form-message {
		margin-top: 0.75rem;
		line-height: 1.6;
		overflow-wrap: anywhere;
	}
	a {
		color: #74bf50;
		text-underline-offset: 0.2em;
	}
	.alternative,
	.personal {
		font-size: 0.9rem;
		line-height: 1.7;
		margin: 0.5rem auto;
	}
	@media (max-width: 35rem) {
		.identity {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.submit-wrap {
			width: 100%;
		}
		.submit-wrap :global(.site-button) {
			width: 100%;
		}
	}
</style>
